          "input": "const specs=[\"model-system-prompts\",\"instance-config\",\"tool-calling\"];\nfor (const spec of specs) {\n const result=await tools.exec_command({cmd:`sed -n '1,1400p' openspec/specs/${spec}/spec.md`,max_output_tokens:30000});\n if (result.exit_code!==0 || result.output.includes(\"Warning: truncated output\")) throw new Error(`Could not read ${spec} completely`);\n store(\"canonical_\"+spec,result.output);\n}\nfunction requirement(spec,name) {\nconst s=load(\"canonical_\"+spec), start=s.indexOf(\"### Requirement: \"+name+\"\\n\");\nif(start<0)throw new Error(name);\nconst end=s.indexOf(\"\\n### Requirement:\",start+1);\nreturn s.slice(start,end<0?undefined:end).trim();\n}\nconst names={\n\"instance-config\":[\"Model prompt files are dedicated visible-content configuration\"],\n\"tool-calling\":[\"Tool failure is an observation, not a crash\",\"Code-owned Knowledge tools use the existing immutable read-only loop\"]\n};\nfor(const [spec,reqs] of Object.entries(names)) for(const name of reqs){const s=requirement(spec,name);store(\"req_\"+name,s);text(s);}\nstore(\"req_model_template\",requirement(\"model-system-prompts\",\"Each model resolves one complete effective system prompt\"));\nstore(\"req_model_snapshot\",requirement(\"model-system-prompts\",\"Every new run binds an immutable effective-context snapshot\"));\n",
