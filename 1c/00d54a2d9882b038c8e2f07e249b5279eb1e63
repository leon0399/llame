e-l),#000_calc(100%_-_var(--marquee-fade-r)),transparent_100%)]\",\n        \"data-[overflowing=true]:[--marquee-fade-r:24px]\",\n        // Hand the fade over from trailing to leading in step with the scroll.\n        \"[transition-property:--marquee-fade-l,--marquee-fade-r] duration-200 ease-out\",\n        \"group-hover/menu-item:data-[overflowing=true]:[--marquee-fade-l:24px] group-hover/menu-item:data-[overflowing=true]:[--marquee-fade-r:0px]\",\n        \"group-focus-within/menu-item:data-[overflowing=true]:[--marquee-fade-l:24px] group-focus-within/menu-item:data-[overflowing=true]:[--marquee-fade-r:0px]\",\n        \"group-hover/menu-item:delay-300 group-hover/menu-item:duration-(--marquee-ms) group-hover/menu-item:ease-linear\",\n        \"group-focus-within/menu-item:delay-300 group-focus-within/menu-item:duration-(--marquee-ms) group-focus-within/menu-item:ease-linear\",\n        className,\n      )}\n    >\n      <span\n        ref={textRef}\n        className={cn(\n          // Leaving reverses at a flat 200ms — faster than the read-speed\n          // scroll — and the 300ms delay ignores quick sweeps across the list.\n          \"inline-block transition-transform duration-200 ease-out\",\n          \"group-hover/menu-item:translate-x-(--marquee-x) group-hover/menu-item:delay-300 group-hover/menu-item:duration-(--marquee-ms) group-hover/menu-item:ease-linear\",\n          \"group-focus-within/menu-item:translate-x-(--marquee-x) group-focus-within/menu-item:delay-300 group-focus-within/menu-item:duration-(--marquee-ms) group-focus-within/menu-item:ease-linear\",\n          // Scrolling text is motion for its own sake to anyone who opted out;\n          // the fade and the native tooltip still carry the meaning.\n          \"motion-reduce:translate-x-0! motion-reduce:transition-none\",\n        )}\n      >\n        {text}\n      </span>\n    </span>\n  );\n}\n\n/** Unused constant guard: keeps FADE documented next to the class above. */\nvoid FADE;\n",
