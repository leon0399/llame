= false;\n    void document.fonts?.ready.then(() => {\n      if (!cancelled) measureAtRest();\n    });\n    return () => {\n      cancelled = true;\n    };\n  }, [measureAtRest]);\n\n  // While the row is hovered its padding animates in, so the scroll distance\n  // is only knowable from the live box. Observing for the length of the hover\n  // (never at rest, never all rows at once) keeps that exact without holding a\n  // ResizeObserver per row for the life of the list.\n  const track = useCallback(() => {\n    const clip = clipRef.current;\n    const node = textRef.current;\n    if (!clip || !node || trackerRef.current) return;\n    const tracker = new ResizeObserver(() => {\n      clip.dataset.clipped = String(node.scrollWidth > clip.clientWidth);\n      writeScroll(clip, node);\n    });\n    tracker.observe(clip);\n    trackerRef.current = tracker;\n  }, []);\n\n  const untrack = useCallback(() => {\n    trackerRef.current?.disconnect();\n    trackerRef.current = null;\n    const clip = clipRef.current;\n    if (clip) clip.dataset.clipped = clip.dataset.overflowing ?? \"false\";\n  }, []);\n\n  useEffect(() => untrack, [untrack]);\n\n  return (\n    <span\n      ref={clipRef}\n      onPointerEnter={track}\n      onPointerLeave={untrack}\n      className={cn(\n        \"block min-w-0 overflow-hidden text-clip whitespace-nowrap\",\n        // Both fades collapse to 0 by default (@property initial value), which\n        // leaves this gradient fully opaque — so it costs an unclipped title\n        // nothing.\n        \"[mask-image:linear-gradient(to_right,transparent_0,#000_var(--marquee-fade-l),#000_calc(100%_-_var(--marquee-fade-r)),transparent_100%)]\",\n        // Anything currently cut off gets the trailing fade — including a\n        // title that only the hover padding clips, which does not scroll.\n        \"data-[clipped=true]:[--marquee-fade-r:24px]\",\n        // A title that overflows at rest hands the fade over as it travels:\n        // trailing shr