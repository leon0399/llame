            "command": "python3 - <<'EOF'\nimport re\ndelta = open('openspec/changes/native-read-directory-listing/specs/native-file-tools/spec.md').read()\nmain = open('openspec/specs/native-file-tools/spec.md').read()\n\n# split delta into sections\nmod_start = delta.index('## MODIFIED Requirements')\nadd_start = delta.index('## ADDED Requirements')\nmod_body = delta[mod_start:add_start].split('\\n',1)[1].strip('\\n')\nadd_body = delta[add_start:].split('\\n',1)[1].strip('\\n')\n\n# split mod_body into two requirement blocks\nblocks = re.split(r'(?m)^(?=### Requirement: )', mod_body)\nblocks = [b for b in blocks if b.strip()]\nassert len(blocks)==2, len(blocks)\n\nlines = main.split('\\n')\n# main indices (0-based): req1 at line 11 (1-based) -> idx 10; req2 idx 41; req3 idx 80\nhead = '\\n'.join(lines[:10]).rstrip('\\n')\ntail = '\\n'.join(lines[80:])\nassert lines[10].startswith('### Requirement: Native tools')\nassert lines[80].startswith('### Requirement: Exact edit')\n\nnew = head + '\\n\\n' + blocks[0].strip('\\n') + '\\n\\n' + blocks[1].strip('\\n') + '\\n\\n' + add_body.strip('\\n') + '\\n\\n' + tail\nopen('openspec/specs/native-file-tools/spec.md','w').write(new)\nprint(\"ok\")\nEOF\ngrep -n \"^### Requirement:\" openspec/specs/native-file-tools/spec.md; wc -l openspec/specs/native-file-tools/spec.md",
