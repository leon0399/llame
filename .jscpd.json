{
  "$schema": "https://raw.githubusercontent.com/kucherenko/jscpd/master/packages/jscpd/schema.json",
  "pattern": "**/*.{ts,tsx}",
  "path": ["apps", "packages"],
  "minLines": 10,
  "minTokens": 70,
  "threshold": 1,
  "reporters": ["consoleFull"],
  "absolute": true,
  "gitignore": true,
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.next/**",
    "**/storybook-static/**",
    "**/coverage/**",

    "**/db/migrations/**",
    "**/lib/api/generated/**",
    "**/oxlint-plugin-anti-slop/vendor/**",

    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.stories.tsx",
    "**/__mocks__/**",
    "**/testing/**",
    "**/evals/**",
    "**/e2e/**"
  ]
}
