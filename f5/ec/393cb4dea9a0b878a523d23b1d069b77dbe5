            "content": "<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<script src=\"./support.js\"></script>\n</head>\n<body>\n<x-dc>\n<helmet>\n  <link rel=\"stylesheet\" href=\"_ds/llame-design-system-0f7e4a36-9f43-4c15-be85-dbf5912a88c9/tokens/fonts.css\">\n  <link rel=\"stylesheet\" href=\"_ds/llame-design-system-0f7e4a36-9f43-4c15-be85-dbf5912a88c9/tokens/colors.css\">\n  <link rel=\"stylesheet\" href=\"_ds/llame-design-system-0f7e4a36-9f43-4c15-be85-dbf5912a88c9/tokens/typography.css\">\n  <link rel=\"stylesheet\" href=\"_ds/llame-design-system-0f7e4a36-9f43-4c15-be85-dbf5912a88c9/tokens/spacing.css\">\n  <link rel=\"stylesheet\" href=\"_ds/llame-design-system-0f7e4a36-9f43-4c15-be85-dbf5912a88c9/tokens/radius.css\">\n  <link rel=\"stylesheet\" href=\"_ds/llame-design-system-0f7e4a36-9f43-4c15-be85-dbf5912a88c9/tokens/elevation.css\">\n  <link rel=\"stylesheet\" href=\"_ds/llame-design-system-0f7e4a36-9f43-4c15-be85-dbf5912a88c9/tokens/base.css\">\n  <link rel=\"stylesheet\" href=\"_ds/llame-design-system-0f7e4a36-9f43-4c15-be85-dbf5912a88c9/styles.css\">\n  <script src=\"_ds/llame-design-system-0f7e4a36-9f43-4c15-be85-dbf5912a88c9/_ds_bundle.js\"></script>\n  <script src=\"llame-common.js\"></script>\n  <script>\n  (function(){\n    if(document.getElementById(\"admin-tree-style\")) return;\n    var css = [\n      \".adm-aside{display:flex;flex-direction:column;flex-shrink:0;width:17rem;height:100%;background:var(--background);border-right:1px solid var(--border);overflow:hidden;}\",\n      \".adm-head{padding:.8rem .9rem .7rem;border-bottom:1px solid var(--border);}\",\n      \".adm-title-row{display:flex;align-items:center;gap:.5rem;color:var(--foreground);}\",\n      \".adm-title{font-weight:600;font-size:.95rem;}\",\n      \".adm-sub{font-size:.72rem;color:var(--muted-foreground);margin-top:.3rem;font-family:var(--font-mono);letter-spacing:-.01em;}\",\n      \".adm-nav{flex:1;overflow-y:auto;padding:.6rem .5rem;display:flex;flex-direction:column;gap:.1rem;}\",\n      \".adm-grp{padding:.4rem .55rem .3rem;font-size:.7rem;font-weight:500;color:color-mix(in oklab,var(--foreground) 50%,transparent);}\",\n      \".adm-item{display:flex;align-items:center;gap:.6rem;width:100%;height:2.15rem;padding:0 .6rem;border:0;background:transparent;cursor:pointer;text-align:left;font-size:.86rem;color:var(--foreground);border-radius:var(--radius-md);font-family:var(--font-sans);transition:background .12s ease;}\",\n      \".adm-item:hover{background:var(--accent);}\",\n      \".adm-item[data-active=\\\"true\\\"]{background:var(--accent);font-weight:500;}\",\n      \".adm-item .ai-ico{color:var(--muted-foreground);display:flex;flex-shrink:0;}\",\n      \".adm-item[data-active=\\\"true\\\"] .ai-ico{color:var(--foreground);}\",\n      \".adm-item .ai-tr{margin-left:auto;font-size:.64rem;color:var(--muted-foreground);border:1px solid var(--border);border-radius:5px;padding:.02rem .3rem;letter-spacing:.01em;}\",\n      \".adm-foot{border-top:1px solid var(--border);padding:.5rem;}\",\n      \".adm-back{display:flex;align-items:center;gap:.55rem;height:2.15rem;padding:0 .6rem;border:0;background:transparent;cursor:pointer;color:var(--muted-foreground);font-size:.83rem;border-radius:var(--radius-md);font-family:var(--font-sans);text-decoration:none;transition:background .12s ease,color .12s ease;}\",\n      \".adm-back:hover{background:var(--accent);color:var(--foreground);}\",\n      \".adm-card{background:var(--card);border:1px solid var(--border);border-radius:var(--radius-xl);box-shadow:var(--shadow-sm);overflow:hidden;}\",\n      \".adm-card-head{display:flex;align-items:center;gap:.55rem;padding:.9rem 1rem;border-bottom:1px solid var(--border);}\",\n      \".adm-card-title{font-weight:600;font-size:.9rem;}\",\n      \".adm-card-count{font-size:.72rem;color:var(--muted-foreground);background:var(--secondary);border-radius:999px;padding:.05rem .45rem;}\",\n      \".adm-card-body{padding:.55rem .6rem;}\",\n      \".tb-btn{display:inline-flex;align-items:center;gap:.4rem;height:2rem;padding:0 .7rem;border:1px solid var(--border);background:var(--background);color:var(--foreground);border-radius:var(--radius-md);font-size:.8rem;cursor:pointer;font-family:var(--font-sans);transition:background .12s ease;white-space:nowrap;}\",\n      \".tb-btn:hover{background:var(--accent);}\",\n      \".tb-btn.primary{background:var(--primary);color:var(--primary-foreground);border-color:var(--primary);}\",\n      \".tb-btn.primary:hover{background:color-mix(in oklab,var(--primary) 90%,black);}\",\n      \".tb-ghost{border-color:transparent;background:transparent;color:var(--muted-foreground);}\",\n      \".tb-ghost:hover{background:var(--accent);color:var(--foreground);}\",\n      \".tree{display:flex;flex-direction:column;padding:.15rem 0;}\",\n      \".tree-row{position:relative;display:flex;align-items:center;height:34px;border-radius:var(--radius-md);cursor:pointer;padding-right:.4rem;transition:background .1s ease;}\",\n      \".tree[data-compact=\\\"true\\\"] .tree-row{height:29px;}\",\n      \".tree-row:hover{background:color-mix(in oklab,var(--accent) 60%,transparent);}\",\n      \".tree-row[data-selected=\\\"true\\\"]{background:var(--accent);box-shadow:inset 0 0 0 1px var(--border);}\",\n      \".tree-row[data-root=\\\"true\\\"] .tw-name{font-weight:600;font-size:.9rem;}\",\n      \".tree-row[data-root=\\\"true\\\"][data-first=\\\"false\\\"]{margin-top:.5rem;}\",\n      \".guide{position:relative;width:22px;flex:0 0 22px;align-self:stretch;}\",\n      \".guide::before{content:\\\"\\\";position:absolute;left:11px;top:0;bottom:0;border-left:1px solid color-mix(in oklab,var(--foreground) 20%,transparent);}\",\n      \".guide[data-kind=\\\"blank\\\"]::before{content:none;}\",\n      \".guide[data-kind=\\\"elbow\\\"]::before{bottom:auto;height:50%;}\",\n      \".guide[data-kind=\\\"tee\\\"]::after,.guide[data-kind=\\\"elbow\\\"]::after{content:\\\"\\\";position:absolute;left:11px;top:50%;width:11px;border-top:1px solid color-mix(in oklab,var(--foreground) 20%,transparent);}\",\n      \".tree[data-guides=\\\"false\\\"] .guide::before,.tree[data-guides=\\\"false\\\"] .guide::after{content:none;}\",\n      \".tw-chevron{width:20px;height:20px;flex:0 0 20px;display:inline-flex;align-items:center;justify-content:center;border:0;background:transparent;cursor:pointer;color:var(--muted-foreground);border-radius:5px;transition:background .12s ease;}\",\n      \".tw-chevron:hover{background:var(--secondary);color:var(--foreground);}\",\n      \".tw-chevron svg{transition:transform .15s ease;}\",\n      \".tw-chevron[data-open=\\\"true\\\"] svg{transform:rotate(90deg);}\",\n      \".tw-chevsp{width:20px;flex:0 0 20px;}\",\n      \".tw-typeicon{display:flex;align-items:center;color:var(--muted-foreground);margin:0 .5rem 0 .1rem;flex-shrink:0;}\",\n      \".tree-row[data-root=\\\"true\\\"] .tw-typeicon{color:var(--foreground);}\",\n      \".tw-name{min-width:0;flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:.86rem;}\",\n      \".tw-right{position:relative;display:flex;align-items:center;justify-content:flex-end;min-width:104px;height:100%;flex-shrink:0;}\",\n      \".tw-meta{display:flex;align-items:center;gap:.45rem;transition:opacity .12s ease;}\",\n      \".tree-row:hover .tw-meta{opacity:0;}\",\n      \".tw-count{display:inline-flex;align-items:center;gap:.3rem;font-size:.74rem;color:var(--muted-foreground);}\",\n      \".role-badge{font-size:.65rem;padding:.06rem .38rem;border:1px solid var(--border);border-radius:6px;color:var(--muted-foreground);background:var(--background);text-transform:capitalize;}\",\n      \".role-badge[data-owner=\\\"true\\\"]{color:var(--foreground);border-color:color-mix(in oklab,var(--foreground) 30%,var(--border));}\",\n      \".tw-actions{position:absolute;right:0;top:50%;transform:translateY(-50%);display:flex;align-items:center;gap:1px;opacity:0;pointer-events:none;transition:opacity .12s ease;}\",\n      \".tree-row:hover .tw-actions{opacity:1;pointer-events:auto;}\",\n      \".tw-act{width:26px;height:26px;display:inline-flex;align-items:center;justify-content:center;border:0;background:transparent;cursor:pointer;color:var(--muted-foreground);border-radius:6px;transition:background .12s ease,color .12s ease;}\",\n      \".tw-act:hover{background:var(--secondary);color:var(--foreground);}\",\n      \".tw-act[data-off=\\\"true\\\"]{opacity:.32;}\",\n      \".tw-act[data-danger=\\\"true\\\"]:hover{background:color-mix(in oklab,var(--destructive) 12%,transparent);color:var(--destructive);}\",\n      \".legend{display:flex;flex-wrap:wrap;gap:.35rem .95rem;margin-top:.95rem;padding:0 .35rem;}\",\n      \".legend-item{display:flex;align-items:center;gap:.35rem;font-size:.73rem;color:var(--muted-foreground);}\",\n      \".legend-item svg{color:color-mix(in oklab,var(--foreground) 55%,transparent);}\",\n      \".sel-foot{border-top:1px solid var(--border);padding:.7rem 1rem;display:flex;align-items:center;gap:.85rem;background:color-mix(in oklab,var(--muted) 45%,transparent);flex-wrap:wrap;}\",\n      \".sel-crumb{display:flex;align-items:center;gap:.4rem;font-size:.82rem;min-width:0;color:var(--foreground);}\",\n      \".sel-crumb svg{color:var(--muted-foreground);flex-shrink:0;}\",\n      \".sel-role{font-size:.75rem;color:var(--muted-foreground);}\",\n      \".tree-empty{padding:2.6rem 1rem;text-align:center;}\",\n      \".adm-placeholder{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:.7rem;text-align:center;color:var(--muted-foreground);padding:2rem;}\",\n      \".adm-ph-ico{width:3.1rem;height:3.1rem;border-radius:var(--radius-lg);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;color:var(--muted-foreground);background:var(--card);}\",\n      \".adm-scrim{position:fixed;inset:0;z-index:80;background:rgb(0 0 0 / .5);animation:fadein .15s ease;display:flex;align-items:flex-start;justify-content:center;}\",\n      \".adm-dialog{margin-top:15vh;width:calc(100% - 2rem);max-width:26rem;background:var(--popover);color:var(--popover-foreground);border:1px solid var(--border);border-radius:var(--radius-lg);box-shadow:var(--shadow-lg);animation:admpop .16s ease;overflow:hidden;}\",\n      \"@keyframes admpop{from{opacity:0;transform:translateY(-8px) scale(.985);}to{opacity:1;transform:none;}}\",\n      \".adm-dlg-head{padding:1.1rem 1.2rem .3rem;}\",\n      \".adm-dlg-title{font-size:1rem;font-weight:600;}\",\n      \".adm-dlg-desc{font-size:.83rem;color:var(--muted-foreground);margin-top:.35rem;line-height:1.45;}\",\n      \".adm-dlg-body{padding:.7rem 1.2rem .2rem;display:flex;flex-direction:column;gap:.55rem;}\",\n      \".adm-label{font-size:.8rem;font-weight:500;}\",\n      \".adm-input{height:2.25rem;border:1px solid var(--border);background:var(--background);border-radius:var(--radius-md);padding:0 .65rem;font-size:.9rem;color:var(--foreground);outline:none;font-family:var(--font-sans);width:100%;}\",\n      \".adm-input:focus{border-color:var(--ring);box-shadow:0 0 0 3px color-mix(in oklab,var(--ring) 45%,transparent);}\",\n      \".type-seg{display:grid;grid-template-columns:repeat(3,1fr);gap:.35rem;}\",\n      \".type-opt{display:flex;flex-direction:column;align-items:center;gap:.3rem;padding:.55rem .3rem;border:1px solid var(--border);border-radius:var(--radius-md);background:var(--background);cursor:pointer;font-size:.71rem;color:var(--muted-foreground);transition:background .12s ease,border-color .12s ease;font-family:var(--font-sans);}\",\n      \".type-opt:hover{background:var(--accent);}\",\n      \".type-opt[data-sel=\\\"true\\\"]{border-color:color-mix(in oklab,var(--foreground) 35%,var(--border));background:var(--accent);color:var(--foreground);}\",\n      \".picker{display:flex;flex-direction:column;gap:1px;max-height:15rem;overflow-y:auto;border:1px solid var(--border);border-radius:var(--radius-md);padding:.25rem;}\",\n      \".picker-opt{display:flex;align-items:center;gap:.5rem;padding:.42rem .5rem;border:0;background:transparent;text-align:left;cursor:pointer;border-radius:6px;font-size:.84rem;color:var(--foreground);font-family:var(--font-sans);}\",\n      \".picker-opt:hover{background:var(--accent);}\",\n      \".picker-opt[data-sel=\\\"true\\\"]{background:var(--accent);}\",\n      \".picker-opt svg{color:var(--muted-foreground);flex-shrink:0;}\",\n      \".dlg-body-text{font-size:.86rem;color:var(--muted-foreground);line-height:1.5;}\",\n      \".adm-dlg-foot{display:flex;justify-content:flex-end;gap:.5rem;padding:.95rem 1.2rem 1.15rem;}\",\n      \".dlg-btn{height:2.25rem;padding:0 .95rem;border-radius:var(--radius-md);font-size:.86rem;cursor:pointer;font-family:var(--font-sans);border:1px solid transparent;transition:background .12s ease;}\",\n      \".dlg-btn.outline{background:var(--background);border-color:var(--border);color:var(--foreground);}\",\n      \".dlg-btn.outline:hover{background:var(--accent);}\",\n      \".dlg-btn.primary{background:var(--primary);color:var(--primary-foreground);}\",\n      \".dlg-btn.primary:hover{background:color-mix(in oklab,var(--primary) 90%,black);}\",\n      \".dlg-btn.danger{background:var(--destructive);color:#fff;}\",\n      \".dlg-btn.danger:hover{background:color-mix(in oklab,var(--destructive) 90%,black);}\",\n      \".dlg-btn[disabled]{opacity:.5;pointer-events:none;}\",\n      \".btn-off{opacity:.55;pointer-events:none;margin-left:auto;}\"\n    ].join(\"\\n\");\n    var st = document.createElement(\"style\");\n    st.id = \"admin-tree-style\";\n    st.textContent = css;\n    document.head.appendChild(st);\n  })();\n  </script>\n</helmet>\n<dc-import name=\"AppShell\" active=\"admin\" dark-mode=\"{{ darkModeVal }}\" hint-size=\"100%,100%\">\n  <aside class=\"adm-aside\">\n    <div class=\"col-header\" style=\"gap:.5rem;padding:0 .75rem;border-bottom:1px solid var(--border);\">\n      <span style=\"display:flex;color:var(--foreground);\">{{ adminIconEl }}</span>\n      <span class=\"adm-title\">Administration</span>\n    </div>\n    <nav class=\"adm-nav\">\n      <div class=\"adm-grp\">Instance</div>\n      <sc-for list=\"{{ sections }}\" as=\"s\" hint-placeholder-count=\"6\">\n        <button class=\"adm-item\" data-active=\"{{ s.active }}\" onClick=\"{{ s.onClick }}\">\n          <span class=\"ai-ico\">{{ s.iconEl }}</span><span>{{ s.label }}</span>\n          <sc-if value=\"{{ s.soon }}\"><span class=\"ai-tr\">soon</span></sc-if>\n        </button>\n      </sc-for>\n    </nav>\n    <div class=\"adm-foot\">\n      <div style=\"padding:.4rem .6rem;font-size:.72rem;color:var(--muted-foreground);font-family:var(--font-mono);letter-spacing:-.01em;\">instance · llame.local</div>\n    </div>\n  </aside>\n\n  <main style=\"flex:1;display:flex;flex-direction:column;min-width:0;background:var(--background);\">\n    <header class=\"col-header\" style=\"gap:.45rem;padding:0 .85rem;border-bottom:1px solid var(--border);\">\n      <span style=\"font-size:.8rem;color:var(--muted-foreground);\">Administration</span>\n      <span style=\"color:var(--muted-foreground);display:flex;\">{{ crumbSepEl }}</span>\n      <span style=\"font-weight:600;font-size:.92rem;\">{{ sectionTitle }}</span>\n    </header>\n\n    <sc-if value=\"{{ isOrgs }}\">\n      <div style=\"flex:1;overflow-y:auto;padding:26px 28px;\">\n        <div style=\"max-width:780px;margin:0 auto;\">\n          <h1 style=\"font-size:22px;font-weight:600;letter-spacing:-.01em;margin:0 0 .35rem;\">Organizations</h1>\n          <p style=\"color:var(--muted-foreground);margin:0 0 1.4rem;font-size:14px;max-width:64ch;line-height:1.5;\">Organization units form a tree — organizations at the root, with groups, teams, and departments nested underneath. Members and permissions inherit down the tree, so a role granted high up applies to everything below it.</p>\n\n          <div class=\"adm-card\">\n            <div class=\"adm-card-head\">\n              <span class=\"adm-card-title\">Organization units</span>\n              <span class=\"adm-card-count\">{{ unitCount }}</span>\n              <div style=\"margin-left:auto;display:flex;gap:.4rem;align-items:center;\">\n                <sc-if value=\"{{ hasUnits }}\"><button class=\"tb-btn tb-ghost\" onClick=\"{{ onToggleAll }}\">{{ toggleAllLabel }}</button></sc-if>\n                <button class=\"tb-btn primary\" onClick=\"{{ onNewOrg }}\">{{ plusEl }}<span>New organization</span></button>\n              </div>\n            </div>\n            <div class=\"adm-card-body\">\n              <sc-if value=\"{{ hasUnits }}\">\n                <div class=\"tree\" role=\"tree\" data-compact=\"{{ treeCompact }}\" data-guides=\"{{ treeGuides }}\">\n                  <sc-for list=\"{{ rows }}\" as=\"r\" hint-placeholder-count=\"9\">\n                    <div class=\"tree-row\" data-selected=\"{{ r.selected }}\" data-root=\"{{ r.isRoot }}\" data-first=\"{{ r.first }}\" role=\"treeitem\" onClick=\"{{ r.onSelect }}\">\n                      <sc-for list=\"{{ r.guides }}\" as=\"g\" hint-placeholder-count=\"0\">\n                        <span class=\"guide\" data-kind=\"{{ g.kind }}\"></span>\n                      </sc-for>\n                      <sc-if value=\"{{ r.hasChildren }}\">\n                        <button class=\"tw-chevron\" data-open=\"{{ r.open }}\" onClick=\"{{ r.onToggle }}\">{{ r.chevronEl }}</button>\n                      </sc-if>\n                      <sc-if value=\"{{ r.leaf }}\"><span class=\"tw-chevsp\"></span></sc-if>\n                      <span class=\"tw-typeicon\">{{ r.iconEl }}</span>\n                      <span class=\"tw-name\">{{ r.name }}</span>\n                      <span class=\"tw-right\">\n                        <span class=\"tw-meta\">\n                          <sc-if value=\"{{ r.hasRole }}\"><span class=\"role-badge\" data-owner=\"{{ r.isOwner }}\">{{ r.role }}</span></sc-if>\n      