tate({\n                  id: todo.id,\n                  status: todo.status === \"completed\" ? \"pending\" : \"completed\",\n                })\n              }\n              onDelete={() => remove.mutate(todo.id)}\n            />\n          ))}\n          {!hasTodos && (\n            <li className=\"text-muted-foreground text-xs\">\n              No todos yet. Add one below.\n            </li>\n          )}\n        </ul>\n        <div className=\"flex gap-2\">\n          <Input\n            value={draft}\n            onChange={(e) => setDraft(e.target.value)}\n            onKeyDown={(e) => {\n              if (e.key === \"Enter\") {\n                e.preventDefault();\n                onAdd();\n              }\n            }}\n            placeholder=\"Add a todo…\"\n            aria-label=\"Add a todo\"\n            maxLength={TODO_CONTENT_MAX}\n            className=\"h-8\"\n          />\n          <Button\n            size=\"sm\"\n            onClick={onAdd}\n            disabled={!draft.trim() || add.isPending}\n          >\n            Add\n          </Button>\n        </div>\n      </div>\n    </details>\n  );\n}\n\nfunction TodoRow({\n  todo,\n  onToggle,\n  onDelete,\n}: {\n  todo: Todo;\n  onToggle: () => void;\n  onDelete: () => void;\n}) {\n  const done = todo.status === \"completed\";\n  const cancelled = todo.status === \"cancelled\";\n  const isUser = todo.source === \"user\";\n\n  const StatusIcon = done ? CheckSquareIcon : cancelled ? XSquareIcon : SquareIcon;\n\n  return (\n    <li className=\"flex items-start gap-2\">\n      <button\n        type=\"button\"\n        onClick={isUser ? onToggle : undefined}\n        disabled={!isUser}\n        aria-label={isUser ? \"Toggle done\" : undefined}\n        className={\n          isUser\n            ? \"text-muted-foreground hover:text-foreground mt-0.5\"\n            : \"text-muted-foreground mt-0.5 cursor-default\"\n        }\n      >\n        <StatusIcon className=\"size-4\" />\n      </button>\n