            "content": "import { defineRule } from \"@oxlint/plugins\";\n\nimport type { ESTree } from \"@oxlint/plugins\";\n\n/** The marker a justification comment must carry, so it is greppable. */\nconst MARKER = \"safe-html:\";\n\n/** How far above the sink a justification may sit before it stops being about it. */\nconst COMMENT_LOOKBACK_LINES = 4;\n\n/**\n * Require every raw-HTML sink to carry a `safe-html:` justification comment.\n *\n * `dangerouslySetInnerHTML` and `innerHTML` assignment are the two places a\n * string becomes markup, and both are legitimate here: llame renders\n * shiki-highlighted code and one prehydration script through them. The hazard\n * is not that they exist, it is that the next one gets added the same way\n * without anyone re-deriving why the input cannot carry attacker markup —\n * particularly on a surface where model output and MCP tool results flow\n * through the page.\n *\n * The rule does not decide whether the HTML is safe. It requires the author to\n * write down who produced the string and why that producer cannot be\n * influenced, and it makes every such claim greppable by one marker.\n *\n * Detection boundary: syntactic. It finds the JSX prop and the member\n * assignment, and it looks for a comment carrying the marker within\n * `COMMENT_LOOKBACK_LINES` above. It cannot evaluate the comment's honesty, and\n * a sink reached through a spread prop or a computed member is invisible to it.\n * A justification comment is a review artifact, not a proof of sanitization.\n */\nexport const requireSafeHtmlJustificationRule = defineRule({\n  meta: {\n    type: \"problem\",\n    docs: {\n      description:\n        \"Require a `safe-html:` comment justifying every dangerouslySetInnerHTML or innerHTML assignment.\",\n    },\n    messages: {\n      unjustified:\n        \"`{{sink}}` renders a raw string as markup with no stated justification. Add a `// {{marker}} …` comment naming who produced the string and why it cannot carry attacker-controlled markup.\",\n    },\n  },\n  createOnce(context) {\n    /** Is a marker comment within reach above `node`? */\n    function hasJustification(node: ESTree.Node): boolean {\n      const line = node.loc?.start.line;\n      if (line === undefined) return false;\n      return context.sourceCode.getAllComments().some((comment) => {\n        const end = comment.loc?.end.line;\n        return (\n          end !== undefined &&\n          end <= line &&\n          line - end <= COMMENT_LOOKBACK_LINES &&\n          comment.value.includes(MARKER)\n        );\n      });\n    }\n\n    function report(node: ESTree.Node, sink: string): void {\n      if (hasJustification(node)) return;\n      context.report({\n        node,\n        messageId: \"unjustified\",\n        data: { sink, marker: MARKER },\n      });\n    }\n\n    return {\n      JSXAttribute(node) {\n        if (\n          node.name.type === \"JSXIdentifier\" &&\n          node.name.name === \"dangerouslySetInnerHTML\"\n        ) {\n          report(node, \"dangerouslySetInnerHTML\");\n        }\n      },\n\n      AssignmentExpression(node) {\n        const { left } = node;\n        if (\n          left.type === \"MemberExpression\" &&\n          !left.computed &&\n          left.property.type === \"Identifier\" &&\n          (left.property.name === \"innerHTML\" ||\n            left.property.name === \"outerHTML\")\n        ) {\n          report(node, left.property.name);\n        }\n      },\n    };\n  },\n});\n",
