\",\n    \"anti-slop/parameter-decorator-own-line\": \"error\",\n    \"anti-slop/require-safety-comment-for-type-assertion\": \"error\",\n\n    // ---- size and shape: the CODING_STANDARDS.md §4 trip-wires -----------\n    // These are the thresholds that document already declares. They were\n    // prose; they are now enforced. When one trips, SIMPLIFY the logic —\n    // carving a function into three private helpers satisfies the number and\n    // makes the code worse (§4 says so explicitly). Never raise a threshold to\n    // pass review.\n    \"complexity\": [\"error\", { \"max\": 35, \"variant\": \"modified\" }],\n    \"max-params\": [\"error\", { \"max\": 4 }],\n    \"max-depth\": [\"error\", { \"max\": 3 }],\n    \"max-lines-per-function\": [\n      \"error\",\n      { \"max\": 40, \"skipBlankLines\": true, \"skipComments\": true }\n    ],\n    \"max-nested-callbacks\": [\"error\", { \"max\": 3 }],\n    \"max-lines\": [\n      \"error\",\n      { \"max\": 500, \"skipBlankLines\": true, \"skipComments\": true }\n    ],\n\n    // ---- markers of unfinished or unreviewed work ------------------------\n    \"no-console\": \"error\",\n    \"unicorn/consistent-function-scoping\": \"error\",\n    \"typescript/no-explicit-any\": \"error\"\n  },\n\n  \"overrides\": [\n    {\n      // Tests and stories are exempt from SIZE and NESTING only. A table-driven\n      // suite is legitimately long, and `describe`/`it` nesting is the idiom —\n      // enforcing 40 lines here would reward splitting one coherent scenario\n      // across helpers that hide what is being asserted. Everything about type\n      // honesty still applies: `no-explicit-any`, every anti-slop rule, and the\n      // focused-test guard are all still errors below.\n      \"files\": [\n        \"**/*.test.ts\",\n        \"**/*.test.tsx\",\n        \"**/*.spec.ts\",\n        \"**/*.stories.tsx\",\n        \"**/*.test-fixture.ts\",\n        \"e2e/support/**\"\n      ],\n      \"rules\": {\n        \"max-lin