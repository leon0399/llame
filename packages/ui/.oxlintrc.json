{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["../../.oxlintrc.json"],
  "env": { "browser": true },
  "ignorePatterns": ["dist/**"],
  "overrides": [
    {
      // These components define the design system, so they own their own
      // classes, arbitrary values, and variant maps. Glob is workspace-local
      // because each workspace runs oxlint from its own directory.
      "files": ["src/components/**"],
      "rules": {
        "shadcn/no-arbitrary-values": "off",
        "shadcn/no-restyle": "off",
        "shadcn/require-static-classes": "off"
      }
    },
    {
      // Regenerated shadcn and AI Elements sources. Keep exceptions here so
      // regeneration does not erase them; custom/** remains fully linted.
      "files": [
        "src/components/*.stories.tsx",
        "src/components/*.tsx",
        "src/components/ai-elements/**/*.tsx"
      ],
      "rules": {
        "anti-slop/no-runtime-typeof": "off",
        "anti-slop/no-unknown-parameters": "off",
        "max-lines": "off",
        "max-lines-per-function": "off",
        "nextjs/no-img-element": "off"
      }
    },
    {
      // Mock story markup is still checked by addon-a11y at render time.
      "files": ["**/*.stories.tsx"],
      "rules": {
        "jsx-a11y/anchor-has-content": "off",
        "jsx-a11y/anchor-is-valid": "off",
        "jsx-a11y/control-has-associated-label": "off",
        "jsx-a11y/no-noninteractive-tabindex": "off",
        "jsx-a11y/prefer-tag-over-role": "off"
      }
    },
    {
      // Upstream primitive semantics and prop forwarding are intentional.
      "files": [
        "src/components/button-group.tsx",
        "src/components/field.tsx",
        "src/components/input-group.tsx",
        "src/components/label.tsx",
        "src/components/spinner.tsx"
      ],
      "rules": {
        "jsx-a11y/click-events-have-key-events": "off",
        "jsx-a11y/label-has-associated-control": "off",
        "jsx-a11y/no-noninteractive-element-interactions": "off",
        "jsx-a11y/prefer-tag-over-role": "off"
      }
    }
  ]
}
