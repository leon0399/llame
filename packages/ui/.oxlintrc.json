{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react", "jsx-a11y"],
  "env": {
    "browser": true
  },
  "ignorePatterns": ["dist/**"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn"
  },
  "overrides": [
    {
      // Illustrative/mock markup in stories (nav-item previews, `href="#"`
      // placeholders, scroll-demo tabIndex) trips these structurally but
      // isn't real product UI. addon-a11y still gates the rendered stories.
      "files": ["**/*.stories.tsx"],
      "rules": {
        "jsx-a11y/anchor-has-content": "off",
        "jsx-a11y/control-has-associated-label": "off",
        "jsx-a11y/prefer-tag-over-role": "off",
        "jsx-a11y/anchor-is-valid": "off",
        "jsx-a11y/no-noninteractive-tabindex": "off"
      }
    },
    {
      // Vendored shadcn primitives (see CLAUDE.md: prefer composing over
      // editing, regenerated by `shadcn add`). Config here survives
      // regeneration; inline disables in these files wouldn't.
      // - spinner/button-group/field: role="status"/"group" are valid ARIA
      //   and match upstream; swapping to <output>/<fieldset> would diverge.
      // - label: generic `<label {...props}/>` wrapper — htmlFor arrives via
      //   spread from the call site, which the rule can't see statically.
      "files": [
        "src/components/spinner.tsx",
        "src/components/button-group.tsx",
        "src/components/field.tsx",
        "src/components/label.tsx"
      ],
      "rules": {
        "jsx-a11y/prefer-tag-over-role": "off",
        "jsx-a11y/label-has-associated-control": "off"
      }
    }
  ]
}
