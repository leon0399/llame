{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // Every rule lives in ../../.oxlintrc.json. This file adds only what is local.
  "extends": ["../../.oxlintrc.json"],
  "env": { "browser": true },
  "ignorePatterns": ["dist/**"],
  "overrides": [
    {
      // Vendored registry output. `src/components/*.tsx` is the @shadcn
      // base-nova registry and `ai-elements/**` the @ai-elements registry;
      // both are OVERWRITTEN in place by `shadcn add` (packages/ui/AGENTS.md
      // §Component organization). Hand-authored components live in
      // `custom/**` and are NOT covered here — they are held to every rule.
      //
      // Only the rules that cannot be satisfied without restructuring the
      // vendored source are lifted. Splitting one of these components into
      // sub-components is a structural fork the next regeneration deletes
      // wholesale, so it buys a green number and silently loses it. The one
      // fork this repository does sanction is component/prop JSDoc, which is
      // cheap to re-apply; a component split is not.
      //
      // `no-img-element` is here for the same reason: swapping <img> for
      // next/image changes the rendered DOM and the network path, which for a
      // story documented as a verbatim transcription of shadcn's own example
      // breaks the thing the story exists to be.
      //
      // Two type-evidence rules are lifted for the same durability reason,
      // and both are rule-precision gaps rather than defects:
      // code-block.tsx guards `typeof window === "undefined"`, which is SSR
      // feature detection with no parameter to write a predicate over, and
      // tool.tsx's `safeStringify(value: unknown)` IS the JSON.stringify
      // boundary for arbitrary tool output, where no narrower honest type
      // exists. An inline directive explaining either would be erased by the
      // next regeneration. Every other rule still applies here and passes.
      "files": [
        "src/components/*.tsx",
        "src/components/ai-elements/**/*.tsx",
        "src/components/*.stories.tsx"
      ],
      "rules": {
        "max-lines-per-function": "off",
        "max-lines": "off",
        "nextjs/no-img-element": "off",
        "anti-slop/no-runtime-typeof": "off",
        "anti-slop/no-unknown-parameters": "off"
      }
    },
    {
      // Illustrative/mock markup in stories (nav-item previews, `href="#"`
      // placeholders, scroll-demo tabIndex) trips these structurally but
      // isn't real product UI. addon-a11y still gates the rendered stories.
      "files": ["**/*.stories.tsx"],
      "rules": {
        "jsx-a11y/anchor-has-content": "off",
        "jsx-a11y/control-has-associated-label": "off",
        "jsx-a11y/prefer-tag-over-role": "off",
        "jsx-a11y/anchor-is-valid": "off",
        "jsx-a11y/no-noninteractive-tabindex": "off"
      }
    },
    {
      // Vendored shadcn primitives (see CLAUDE.md: prefer composing over
      // editing, regenerated by `shadcn add`). Config here survives
      // regeneration; inline disables in these files wouldn't.
      // - spinner/button-group/field: role="status"/"group" are valid ARIA
      //   and match upstream; swapping to <output>/<fieldset> would diverge.
      // - label: generic `<label {...props}/>` wrapper — htmlFor arrives via
      //   spread from the call site, which the rule can't see statically.
      // - input-group: its addon forwards a click to the group's input, the
      //   same courtesy a <label> gives; the control itself is a real focusable
      //   input, so the addon adds no keyboard path that isn't already there.
      "files": [
        "src/components/spinner.tsx",
        "src/components/button-group.tsx",
        "src/components/field.tsx",
        "src/components/label.tsx",
        "src/components/input-group.tsx"
      ],
      "rules": {
        "jsx-a11y/prefer-tag-over-role": "off",
        "jsx-a11y/label-has-associated-control": "off",
        "jsx-a11y/click-events-have-key-events": "off",
        "jsx-a11y/no-noninteractive-element-interactions": "off"
      }
    }
  ]
}
