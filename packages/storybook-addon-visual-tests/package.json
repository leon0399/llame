{
  "name": "storyproof",
  "version": "0.0.1-alpha.1",
  "description": "Local visual regression testing for Storybook: capture Chromium screenshots, review diffs, and approve baselines committed next to your stories — no cloud service.",
  "keywords": [
    "storybook-addons",
    "storybook",
    "visual-testing",
    "visual-regression-testing",
    "screenshot-testing",
    "snapshot-testing",
    "regression-testing",
    "visual-diff",
    "playwright",
    "chromium",
    "testing",
    "addon"
  ],
  "homepage": "https://storyproof.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leon0399/llame.git",
    "directory": "packages/storybook-addon-visual-tests"
  },
  "bugs": "https://github.com/leon0399/llame/issues",
  "author": "Leonid Meleshin (https://leon0399.me)",
  "license": "MIT",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "storybook": {
    "displayName": "Storyproof",
    "icon": "https://storyproof.dev/icon.svg",
    "supportedFrameworks": [
      "react"
    ]
  },
  "type": "module",
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "prepack": "pnpm build",
    "pack:artifact": "node ./scripts/pack-artifact.mjs",
    "lint": "oxlint --deny-warnings",
    "test": "pnpm test:build && vitest run",
    "test:build": "node ./test/build-artifact.mjs",
    "test:exports": "node ./scripts/test-exports.mjs",
    "test:pack": "node ./scripts/test-pack.mjs",
    "test:visual": "playwright test",
    "typecheck": "tsgo --noEmit"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./manager": {
      "types": "./dist/manager.d.ts",
      "import": "./dist/manager.js"
    },
    "./preset": {
      "types": "./dist/preset.d.ts",
      "import": "./dist/preset.js"
    },
    "./preview": {
      "types": "./dist/preview.d.ts",
      "import": "./dist/preview.js"
    }
  },
  "dependencies": {
    "@storybook/icons": "2.1.0",
    "pixelmatch": "^7.1.0",
    "playwright": "catalog:",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@storybook/nextjs-vite": "catalog:",
    "@storybook/react-vite": "^10.5.0",
    "@types/node": "catalog:",
    "@types/pngjs": "^6.0.5",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@typescript/native-preview": "catalog:",
    "@workspace/config-typescript": "workspace:*",
    "oxlint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "storybook": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "storybook": "^10.5.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
