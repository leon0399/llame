{
  "name": "@workspace/git-executor",
  "version": "0.0.1",
  "private": true,
  "description": "Typed git operations shared by the hub's local executor and the Machine daemon.",
  "dependencies": {
    "@workspace/machine-protocol": "workspace:*"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives",
    "lint:fix": "oxlint --deny-warnings --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --reporter=default --reporter=junit --outputFile.junit=coverage/junit.xml && crap-typescript --threshold 42 --format none src",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@barney-media/crap-typescript": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@workspace/config-typescript": "workspace:*",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
