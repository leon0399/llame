{
  "name": "@workspace/oxlint-plugin-anti-slop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.ts"
  },
  "scripts": {
    "lint": "oxlint --deny-warnings --report-unused-disable-directives",
    "lint:fix": "oxlint --deny-warnings --fix",
    "test": "node registry.check.mjs && vitest run",
    "test:coverage": "node registry.check.mjs && vitest run --coverage && crap-typescript --threshold 42 --format none rules shared index.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@barney-media/crap-typescript": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
