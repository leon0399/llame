{
  "name": "@workspace/node-client",
  "version": "0.0.1",
  "private": true,
  "description": "Reusable personal IPC and authenticated hosted client adapters. No terminal renderer or database access.",
  "exports": {
    ".": "./dist/index.js",
    "./*": "./dist/*.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives"
  },
  "dependencies": {
    "@workspace/personal-node": "workspace:*",
    "@workspace/node-protocol": "workspace:*",
    "@workspace/runtime-safety": "workspace:*",
    "@workspace/node": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@workspace/config-typescript": "workspace:*",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  }
}
