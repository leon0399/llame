    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "4.1.11",
    "@workspace/config-typescript": "workspace:*",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
