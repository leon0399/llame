// llame operator configuration (JSONC).
// Copy this file to `llame.config.json` (or point LLAME_CONFIG_PATH at it):
//   cp apps/api/llame.config.json.example apps/api/llame.config.json
//
// File values override built-in defaults. Invalid configuration fails startup;
// changes take effect after restart. Use {env:NAME}, {env:NAME:-default},
// {path:/run/secrets/name}, or {path:/run/secrets/auth.json|json:/providers/openai/key}
// (RFC 6901; pointer must select a JSON string) for string interpolation.
// Use {{ for a literal {.
{
  "$schema": "./src/instance-config/llame.config.schema.json",

  // Optional MCP servers, remote or local. Inspect a server's tool names with
  // MCP Explorer: https://mcpplaygroundonline.com/mcp-test-server
  "mcpServers": {
    // "docs": { "type": "http", "url": "https://example.com/mcp" }
    // A local server runs as a child process, unsandboxed, as the llame user.
    // Interpolating a value marks it secret; write non-secrets literally.
    // "github": {
    //   "type": "stdio",
    //   "command": "docker",
    //   "args": ["run", "-i", "--rm", "--init",
    //            "-e", "GITHUB_PERSONAL_ACCESS_TOKEN",
    //            "ghcr.io/github/github-mcp-server", "--read-only"],
    //   "env": { "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_MCP_PAT}" }
    // }
  },

  // Each default must name an id from models[] below.
  "defaults": {
    "modelId": "{env:DEFAULT_MODEL_ID:-system:openai:gpt-5.4-mini}",
    "titleGenerationModelId": "{env:TITLE_GENERATION_MODEL_ID:-system:openai:gpt-5.4-nano}",
  },

  // OpenAI-compatible provider connections. Omit key for a keyless endpoint.
  "providers": [
    {
      "id": "openai",
      "type": "openai",
      "key": "{env:OPENAI_API_KEY:-}",
      "baseUrl": "{env:OPENAI_BASE_URL:-}",
    },
    // Add another provider for a local or compatible endpoint:
    // {
    //   "id": "ollama",
    //   "type": "openai",
    //   "baseUrl": "{env:OLLAMA_BASE_URL:-http://localhost:11434/v1}"
    // }
  ],

  // Executable model catalog. Each provider must name a providers[].id.
  // systemPromptFile is an optional complete prompt replacement; do not put
  // credentials or host-sensitive data in prompt files.
  "models": [
    {
      "id": "system:openai:gpt-5.6-sol",
      "provider": "openai",
      "providerModelId": "gpt-5.6-sol",
      // "systemPromptFile": "./prompts/gpt-5.6-sol.md",
      "name": "GPT-5.6 Sol",
      "description": "Flagship frontier reasoning model for complex agentic and scientific tasks.",
      "contextWindowTokens": 1050000,
      "pricingUsdPer1M": { "input": 5, "cachedInput": 0.5, "output": 30 },
      // Reasoning effort (add-reasoning-effort). Presence declares that this
      // model accepts a per-request `effort`; absence means it accepts none.
      // The levels are the PROVIDER's own tokens, passed through untouched —
      // llame never normalizes them, so a value the provider ships tomorrow
      // needs only a config edit. Order is what a client presents as the scale.
      // `cacheInvalidatedByEffortChange` is advisory: set it when CHANGING
      // effort mid-conversation costs a full prompt-cache prefix re-read on
      // this model, so a client can warn first. It never affects execution.
      "reasoning": {
        "effortLevels": [
          "none",
          "low",
          "medium",
          "high",
          { "value": "xhigh", "label": "Extra High" },
          "max"
        ],
        "defaultEffort": "medium",
        "cacheInvalidatedByEffortChange": true
      },
      "knowledgeCutoff": "2026-02",
      "website": "https://openai.com",
      "releasedAt": "2026-07-09",
    },
    {
      "id": "system:openai:gpt-5.6-terra",
      "provider": "openai",
      "providerModelId": "gpt-5.6-terra",
      "name": "GPT-5.6 Terra",
      "description": "Balanced mid-tier model, competitive with GPT-5.5 at roughly half the cost.",
      "contextWindowTokens": 1050000,
      "pricingUsdPer1M": { "input": 2.5, "cachedInput": 0.25, "output": 15 },
      "reasoning": {
        "effortLevels": ["none", "low", "medium", "high", "xhigh"],
        "defaultEffort": "medium",
        "cacheInvalidatedByEffortChange": true
      },
      "knowledgeCutoff": "2026-02",
      "website": "https://openai.com",
      "releasedAt": "2026-07-09",
    },
    {
      "id": "system:openai:gpt-5.6-luna",
      "provider": "openai",
      "providerModelId": "gpt-5.6-luna",
      "name": "GPT-5.6 Luna",
      "description": "Lightweight, high-throughput tier for classification, routing, and high-volume tasks.",
      "contextWindowTokens": 1050000,
      "pricingUsdPer1M": { "input": 1, "cachedInput": 0.1, "output": 6 },
      "knowledgeCutoff": "2026-02",
      "website": "https://openai.com",
      "releasedAt": "2026-07-09",
    },
    {
      "id": "system:openai:gpt-5.5",
      "provider": "openai",
      "providerModelId": "gpt-5.5",
      "name": "GPT-5.5",
      "description": "Most capable system OpenAI-compatible model.",
      "contextWindowTokens": 400000,
      "pricingUsdPer1M": { "input": 2.5, "cachedInput": 0.25, "output": 10 },
      "reasoning": {
        "effortLevels": ["none", "low", "medium", "high", "xhigh"],
        "defaultEffort": "medium",
        "cacheInvalidatedByEffortChange": true
      },
      "website": "https://openai.com",
    },
    {
      "id": "system:openai:gpt-5.4",
      "provider": "openai",
      "providerModelId": "gpt-5.4",
      "name": "GPT-5.4",
      "description": "High-capability system OpenAI-compatible model.",
      "contextWindowTokens": 400000,
      "pricingUsdPer1M": { "input": 1.25, "cachedInput": 0.125, "output": 7.5 },
      "reasoning": {
        "effortLevels": ["none", "low", "medium", "high", "xhigh"],
        "defaultEffort": "medium",
        "cacheInvalidatedByEffortChange": true
      },
      "website": "https://openai.com",
    },
    {
      "id": "system:openai:gpt-5.4-mini",
      "provider": "openai",
      "providerModelId": "gpt-5.4-mini",
      "name": "GPT-5.4 Mini",
      "description": "Balanced default system OpenAI-compatible model.",
      "contextWindowTokens": 400000,
      "pricingUsdPer1M": { "input": 0.75, "cachedInput": 0.075, "output": 4.5 },
      "reasoning": {
        "effortLevels": ["none", "low", "medium", "high", "xhigh"],
        "defaultEffort": "medium",
        "cacheInvalidatedByEffortChange": true
      },
      "website": "https://openai.com",
      // Optional per-model compaction threshold; otherwise 80% of the context window.
      "compactionThresholdTokens": 300,
    },
    {
      "id": "system:openai:gpt-5.4-nano",
      "provider": "openai",
      "providerModelId": "gpt-5.4-nano",
      "name": "GPT-5.4 Nano",
      "description": "Small system OpenAI-compatible model for internal work.",
      "contextWindowTokens": 400000,
      "pricingUsdPer1M": { "input": 0.1, "cachedInput": 0.01, "output": 0.4 },
      "website": "https://openai.com",
    },
    {
      "id": "system:openai:gpt-4o",
      "provider": "openai",
      "providerModelId": "gpt-4o",
      "name": "GPT-4o",
      "description": "Fast, intelligent, flexible GPT model.",
      "contextWindowTokens": 128000,
      "pricingUsdPer1M": { "input": 2.5, "output": 10 },
      "knowledgeCutoff": "2023-10-01",
      "website": "https://openai.com",
      "apiDocs": "https://platform.openai.com/docs/models/gpt-4o",
      "modelPage": "https://platform.openai.com/docs/models/gpt-4o",
      "releasedAt": "2024-08-06",
    },
    {
      "id": "system:openai:gpt-4o-mini",
      "provider": "openai",
      "providerModelId": "gpt-4o-mini",
      "name": "GPT-4o Mini",
      "contextWindowTokens": 128000,
      "pricingUsdPer1M": { "input": 0.15, "cachedInput": 0.075, "output": 0.6 },
      "website": "https://openai.com",
      "apiDocs": "https://platform.openai.com/docs/models/gpt-4o-mini",
      "modelPage": "https://platform.openai.com/docs/models/gpt-4o-mini",
    },
  ],

  // Optional declared embedding models, reusing a providers[] connection
  // above. Declaring one and selecting it below is the entire off-by-default
  // contract: with neither set, search behavior is unchanged.
  // "embeddingModels": [
  //   {
  //     "id": "openai:text-embedding-3-large",
  //     "provider": "openai",
  //     "providerModelId": "text-embedding-3-large",
  //     // TODO: make non-required
  //     "dimensions": 3072
  //   }
  // ],

  // Per-corpus intended-embedding-model selection. Unset (default) means no
  // embedding work is scheduled for that corpus.
  // "search": {
  //   "chats": {
  //     "embeddingModelId": "openai:text-embedding-3-large"
  //   }
  // },

  // Run limits. Interpolated numbers must be whole-value quoted tokens.
  "runs": {
    // Reserved from the context window when checking request fit.
    "maxOutputTokens": null,
    // pg-boss worker-liveness window (minimum 10 seconds).
    "heartbeatSeconds": "{env:RUN_HEARTBEAT_SECONDS:-15}",
    // Wall-clock budget for an active run.
    "timeoutSeconds": "{env:RUN_TIMEOUT_SECONDS:-300}",
  },

  "http": {
    // Leave unset unless the API runs behind a trusted reverse proxy.
    "trustProxy": "{env:TRUST_PROXY:-}",
  },

  // Database connection-pool size.
  "db": {
    "poolSize": "{env:DB_POOL_SIZE:-10}",
  },

  // Optional private root for server-managed Knowledge Space directories.
  // The value must resolve to an absolute path. Loading this setting does not
  // require the path to exist or be mounted; provisioning creates one stable-ID
  // child per owner. Mount the same logical children read-only into every runs
  // consumer and with write access only where provisioning is served.
  // "knowledge": {
  //   "root": "{env:KNOWLEDGE_ROOT}",
  // },

  // Empty allowed disables tools. MCP ids are mcp__<server>__<tool>.
  // Exact ids are safer; use mcp__<server>__* only for an entirely read-only server.
  "tools": {
    // Built-in or discovered MCP tool ids to allow. To enable Knowledge after
    // mounting the root above, add "knowledge_search" and "knowledge_read".
    // Allowlisting search_conversations makes complete canonical projection
    // coverage a startup gate. Add conversation_read independently for exact
    // line reads; see docs/conversation-recall.md.
    "allowed": ["search_conversations"],
    // Maximum tool-requesting steps per run.
    "maxStepsPerRun": 20,
    // Per-tool-call timeout in seconds.
    "callTimeoutSeconds": 120,
  },

  // Optional worker-profile concurrency overrides. See docs/scaling.md.
  // "workers": {
  //   "all": { "runs": 4 },
  //   "heavy": { "search-reindex": 2 }
  // }
}
