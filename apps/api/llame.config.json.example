// llame operator configuration (JSONC).
// Copy this file to `llame.config.json` (or point LLAME_CONFIG_PATH at it):
//   cp apps/api/llame.config.json.example apps/api/llame.config.json
//
// File values override built-in defaults. Invalid configuration fails startup;
// changes take effect after restart. Use {env:NAME}, {env:NAME:-default},
// {path:/run/secrets/name}, or {path:/run/secrets/auth.json|json:/providers/openai/key}
// (RFC 6901; pointer must select a JSON string) for string interpolation.
// Use {{ for a literal {.
{
  "$schema": "./src/instance-config/llame.config.schema.json",

  // Optional MCP servers, remote or local. Inspect a server's tool names with
  // MCP Explorer: https://mcpplaygroundonline.com/mcp-test-server
  "mcpServers": {
    // "docs": { "type": "http", "url": "https://example.com/mcp" }
    // A local server runs as a child process, unsandboxed, as the llame user.
    // Interpolating a value marks it secret; write non-secrets literally.
    // "github": {
    //   "type": "stdio",
    //   "command": "docker",
    //   "args": ["run", "-i", "--rm", "--init",
    //            "-e", "GITHUB_PERSONAL_ACCESS_TOKEN",
    //            "ghcr.io/github/github-mcp-server", "--read-only"],
    //   "env": { "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_MCP_PAT}" }
    // }
  },

  // Each default must name an id from models[] below.
  "defaults": {
    "modelId": "{env:DEFAULT_MODEL_ID:-system:openai:gpt-5.4-mini}",
    "titleGenerationModelId": "{env:TITLE_GENERATION_MODEL_ID:-system:openai:gpt-5.4-nano}",
  },

  // Provider connections. `type` names the wire the entry speaks:
  // `openai-responses` for the Responses API (baseUrl optional) or
  // `openai-completions` for Chat Completions (baseUrl required),
  // `anthropic-messages` for the Anthropic Messages API (baseUrl optional,
  // defaulting to the Anthropic API at https://api.anthropic.com/v1), or
  // `opencode-go` for the OpenCode Go subscription gateway (Chat Completions
  // at an endpoint fixed in llame's code; key required, no baseUrl). Omit key
  // for a keyless endpoint.
  "providers": [
    {
      "id": "openai",
      "type": "openai-responses",
      "key": "{env:OPENAI_API_KEY:-}",
      "baseUrl": "{env:OPENAI_BASE_URL:-}",
    },
    // Add another provider for a local or compatible endpoint; the baseUrl
    // must resolve non-blank:
    // {
    //   "id": "ollama",
    //   "type": "openai-completions",
    //   "baseUrl": "{env:OLLAMA_BASE_URL:-http://localhost:11434/v1}"
    // }
    // Anthropic's Messages wire, named after the wire like the OpenAI types.
    // A gateway or proxy that speaks Messages is this type with its own
    // baseUrl, never a second type. The example keeps the provider available
    // without requiring a credential at boot; requests fail at the provider
    // until ANTHROPIC_API_KEY is set. The client always passes an explicit
    // base URL (the configured value or https://api.anthropic.com/v1), so an
    // ambient ANTHROPIC_BASE_URL cannot move a request off the configured endpoint.
    // Thinking, caching, effort, and output-limit behavior is documented in
    // README.md.
    {
      "id": "anthropic",
      "type": "anthropic-messages",
      "key": "{env:ANTHROPIC_API_KEY:-}",
    },
    // A ChatGPT/Codex subscription uses fixed transport settings and a
    // file-backed `codex login` credential snapshot. See
    // docs/codex-subscription.md for the required stop/re-login/restart flow.
    // {
    //   "id": "personal-codex",
    //   "type": "openai-codex",
    //   "key": "{path:/run/secrets/codex-auth.json|json:/tokens/access_token}",
    //   "accountId": "{path:/run/secrets/codex-auth.json|json:/tokens/account_id}"
    // }
    // An OpenCode Go subscription is key-only: the endpoint is fixed in
    // llame's code, so this entry accepts no baseUrl, and the key is required
    // because the gateway authenticates every request. That is why the
    // provider AND its two models ship commented out — an unconfigured
    // required key cannot boot. Uncomment every line between the two
    // `opencode-go block` markers in this file (this provider and the two
    // models in `models[]`), set OPENCODE_GO_API_KEY, and restart. See
    // docs/opencode-go.md for the credential, the fixed endpoint, the route
    // ceiling, and the per-model privacy divergence.
    // --- opencode-go block: start ---
    // {
    //   "id": "opencode-go",
    //   "type": "opencode-go",
    //   "key": "{env:OPENCODE_GO_API_KEY}"
    // },
    // --- opencode-go block: end ---
  ],

  // Executable model catalog. Each provider must name a providers[].id.
  // systemPromptFile is an optional complete prompt replacement; do not put
  // credentials or host-sensitive data in prompt files.
  "models": [
    {
      "id": "system:openai:gpt-5.6-sol",
      "provider": "openai",
      "providerModelId": "gpt-5.6-sol",
      // "systemPromptFile": "./prompts/gpt-5.6-sol.md",
      // Optional whole-file replacement for one llame-owned tool description
      // on this model, keyed by tool id. Wins over tools.promptFiles below;
      // see docs/tool-prompts.md.
      // "toolPromptFiles": { "bash": "./prompts/gpt-5.6-sol-bash.md" },
      "name": "GPT-5.6 Sol",
      "description": "Flagship frontier reasoning model for complex agentic and scientific tasks.",
      "contextWindowTokens": 1050000,
      // Optional cacheWrite rate (per million tokens) for provider-reported
      // cache-creation tokens. Absent, those tokens are priced at `input`,
      // which is exactly the pre-field behavior. The web usage panel shows
      // the count as an "of which cache write" row under Input.
      "pricingUsdPer1M": { "input": 5, "cachedInput": 0.5, "output": 30 },
      // Reasoning effort (add-reasoning-effort). Presence declares that this
      // model accepts a per-request `effort`; absence means it accepts none.
      // The levels are the PROVIDER's own tokens, passed through untouched —
      // llame never normalizes them, so a value the provider ships tomorrow
      // needs only a config edit. Order is what a client presents as the scale.
      // `cacheInvalidatedByEffortChange` is advisory: set it when CHANGING
      // effort mid-conversation costs a full prompt-cache prefix re-read on
      // this model, so a client can warn first. It never affects execution.
      "reasoning": {
        "effortLevels": [
          "none",
          "low",
          "medium",
          "high",
          { "value": "xhigh", "label": "Extra High" },
          "max"
        ],
        "defaultEffort": "medium",
        "cacheInvalidatedByEffortChange": true
      },
      // Optional provider-native request options for the adapter this
      // provider's `type` selects, keyed as that adapter documents them
      // (`reasoningSummary` on the Responses wire, `reasoningEffort` on Chat
      // Completions, `thinking`/`effort`/`cacheControl` on the Messages
      // wire); llame places them under the wire's provider-options namespace
      // itself (`openai`, `openaiCompletions` for Chat Completions, or
      // `anthropic` for Messages). Server-only and free-form: boot checks
      // only that the value is an object and rejects {env:...}/{path:...}
      // syntax in any string value at any depth before resolving anything.
      // Not a credential channel — contents are never redacted, so never put
      // a secret in it.
      // Precedence, highest first: client invariants (Codex always sends
      // store:false and reasoningSummary:auto; the Messages client always
      // sends sendReasoning:true and, on adaptive thinking, the
      // drop-on-prefix-mismatch instruction), the run's resolved effort
      // when this model declares `reasoning`, this object, then per-request
      // defaults (the Responses client defaults reasoningSummary:auto on
      // streaming and compaction only; the Messages client defaults adaptive
      // thinking with summarized display when this model declares
      // `reasoning`, plus the request-level ephemeral cache control on every
      // request). Objects merge recursively key by key; arrays and scalars
      // replace the value beneath them; null at any depth removes a default,
      // never an invariant. Reserved keys are stripped before composition:
      // conversation, previousResponseId, instructions, systemMessageMode,
      // allowedTools on the Responses wire; model, max_tokens, tool_choice on
      // the Chat Completions wire; fallbacks, mcpServers, container, and
      // thinking.blockBinding on the Messages wire. A value the adapter
      // recognizes and rejects fails that request; an unknown key is dropped
      // by the Responses and Anthropic adapters and forwarded into the
      // request body by openai-completions.
      // "providerOptions": { "reasoningSummary": "detailed" },
      // Optional per-model output-token limit (positive integer or whole-value
      // interpolation token, validated after resolution), sent as every
      // request's maxOutputTokens setting: max_output_tokens on the Responses
      // wire, max_tokens on Chat Completions (with no max_completion_tokens
      // remapping — a model that requires that field rejects a declared
      // limit), and max_tokens on the Messages wire, where the adapter adds a
      // manual thinking budget to it silently and lowers a value above a
      // ceiling it knows for a recognized model, warning only when the entry
      // declared the limit. Absent leaves the adapter's default: no limit on
      // the OpenAI wires; on the Messages wire the adapter fills max_tokens
      // from its model-id table — 128k for the recognized current models and
      // unrecognized claude- ids, 64k/32k for the 4.5 and older 4.x rows,
      // 4096 for the Claude 3 Haiku, Claude 2, and Claude Instant rows and
      // any id without `claude-` — with thinking tokens counted against it.
      // This caps provider output; runs.maxOutputTokens above does not.
      // "maxOutputTokens": 32000,
      "knowledgeCutoff": "2026-02",
      "website": "https://openai.com",
      "releasedAt": "2026-07-09",
    },
    {
      "id": "system:openai:gpt-5.6-terra",
      "provider": "openai",
      "providerModelId": "gpt-5.6-terra",
      "name": "GPT-5.6 Terra",
      "description": "Balanced mid-tier model, competitive with GPT-5.5 at roughly half the cost.",
      "contextWindowTokens": 1050000,
      "pricingUsdPer1M": { "input": 2.5, "cachedInput": 0.25, "output": 15 },
      "reasoning": {
        "effortLevels": ["none", "low", "medium", "high", "xhigh"],
        "defaultEffort": "medium",
        "cacheInvalidatedByEffortChange": true
      },
      "knowledgeCutoff": "2026-02",
      "website": "https://openai.com",
      "releasedAt": "2026-07-09",
    },
    {
      "id": "system:openai:gpt-5.6-luna",
      "provider": "openai",
      "providerModelId": "gpt-5.6-luna",
      "name": "GPT-5.6 Luna",
      "description": "Lightweight, high-throughput tier for classification, routing, and high-volume tasks.",
      "contextWindowTokens": 1050000,
      "pricingUsdPer1M": { "input": 1, "cachedInput": 0.1, "output": 6 },
      "knowledgeCutoff": "2026-02",
      "website": "https://openai.com",
      "releasedAt": "2026-07-09",
    },
    {
      "id": "system:openai:gpt-5.5",
      "provider": "openai",
      "providerModelId": "gpt-5.5",
      "name": "GPT-5.5",
      "description": "Most capable system OpenAI-compatible model.",
      "contextWindowTokens": 400000,
      "pricingUsdPer1M": { "input": 2.5, "cachedInput": 0.25, "output": 10 },
      "reasoning": {
        "effortLevels": ["none", "low", "medium", "high", "xhigh"],
        "defaultEffort": "medium",
        "cacheInvalidatedByEffortChange": true
      },
      "website": "https://openai.com",
    },
    {
      "id": "system:openai:gpt-5.4",
      "provider": "openai",
      "providerModelId": "gpt-5.4",
      "name": "GPT-5.4",
      "description": "High-capability system OpenAI-compatible model.",
      "contextWindowTokens": 400000,
      "pricingUsdPer1M": { "input": 1.25, "cachedInput": 0.125, "output": 7.5 },
      "reasoning": {
        "effortLevels": ["none", "low", "medium", "high", "xhigh"],
        "defaultEffort": "medium",
        "cacheInvalidatedByEffortChange": true
      },
      "website": "https://openai.com",
    },
    {
      "id": "system:openai:gpt-5.4-mini",
      "provider": "openai",
      "providerModelId": "gpt-5.4-mini",
      "name": "GPT-5.4 Mini",
      "description": "Balanced default system OpenAI-compatible model.",
      "contextWindowTokens": 400000,
      "pricingUsdPer1M": { "input": 0.75, "cachedInput": 0.075, "output": 4.5 },
      "reasoning": {
        "effortLevels": ["none", "low", "medium", "high", "xhigh"],
        "defaultEffort": "medium",
        "cacheInvalidatedByEffortChange": true
      },
      "website": "https://openai.com",
      // Optional per-model compaction threshold; otherwise 80% of the context window.
      "compactionThresholdTokens": 300,
    },
    {
      "id": "system:openai:gpt-5.4-nano",
      "provider": "openai",
      "providerModelId": "gpt-5.4-nano",
      "name": "GPT-5.4 Nano",
      "description": "Small system OpenAI-compatible model for internal work.",
      "contextWindowTokens": 400000,
      "pricingUsdPer1M": { "input": 0.1, "cachedInput": 0.01, "output": 0.4 },
      "website": "https://openai.com",
    },
    {
      "id": "system:openai:gpt-4o",
      "provider": "openai",
      "providerModelId": "gpt-4o",
      "name": "GPT-4o",
      "description": "Fast, intelligent, flexible GPT model.",
      "contextWindowTokens": 128000,
      "pricingUsdPer1M": { "input": 2.5, "output": 10 },
      "knowledgeCutoff": "2023-10-01",
      "website": "https://openai.com",
      "apiDocs": "https://platform.openai.com/docs/models/gpt-4o",
      "modelPage": "https://platform.openai.com/docs/models/gpt-4o",
      "releasedAt": "2024-08-06",
    },
    {
      "id": "system:openai:gpt-4o-mini",
      "provider": "openai",
      "providerModelId": "gpt-4o-mini",
      "name": "GPT-4o Mini",
      "contextWindowTokens": 128000,
      "pricingUsdPer1M": { "input": 0.15, "cachedInput": 0.075, "output": 0.6 },
      "website": "https://openai.com",
      "apiDocs": "https://platform.openai.com/docs/models/gpt-4o-mini",
      "modelPage": "https://platform.openai.com/docs/models/gpt-4o-mini",
    },
    {
      "id": "system:anthropic:claude-haiku-4.5",
      "provider": "anthropic",
      "providerModelId": "claude-haiku-4-5-20251001",
      "name": "Claude Haiku 4.5",
      "description": "Anthropic's lowest-cost current model for fast, high-volume work.",
      "contextWindowTokens": 200000,
      "pricingUsdPer1M": {
        "input": 1,
        "cachedInput": 0.1,
        "cacheWrite": 1.25,
        "output": 5
      },
      "knowledgeCutoff": "2025-02",
      "website": "https://anthropic.com",
      "modelPage": "https://platform.claude.com/docs/en/models/haiku-4-5/overview",
      "releasedAt": "2025-10-15",
    },
    {
      "id": "system:anthropic:claude-sonnet-5",
      "provider": "anthropic",
      "providerModelId": "claude-sonnet-5",
      "name": "Claude Sonnet 5",
      "description": "Lowest-cost current Anthropic model that supports adaptive thinking.",
      "contextWindowTokens": 1000000,
      "pricingUsdPer1M": {
        "input": 2,
        "cachedInput": 0.2,
        "cacheWrite": 2.5,
        "output": 10
      },
      "reasoning": {
        "effortLevels": [
          "low",
          "medium",
          "high",
          { "value": "xhigh", "label": "Extra High" },
          "max"
        ],
        "defaultEffort": "low",
        "cacheInvalidatedByEffortChange": true
      },
      "knowledgeCutoff": "2026-01",
      "website": "https://anthropic.com",
      "modelPage": "https://platform.claude.com/docs/en/models/sonnet-5/overview",
      "releasedAt": "2026-06-29",
    },
    // OpenCode Go's two shipped models — uncomment with the provider block in
    // `providers[]` above (both blocks carry the same markers). Both execute
    // Chat Completions at the fixed gateway endpoint. No `pricingUsdPer1M`:
    // the subscription bills per-model usage windows, not per token, so llame
    // records `costUsd: null` unless an operator declares a rate. The
    // Contributor models are deliberately absent — they train on prompts; see
    // docs/opencode-go.md.
    // --- opencode-go block: start ---
    // {
    //   "id": "system:opencode-go:glm-5.3-flash",
    //   "provider": "opencode-go",
    //   "providerModelId": "glm-5.3-flash",
    //   "name": "GLM-5.3 Flash",
    //   "description": "Fast general-purpose coding model on the OpenCode Go subscription.",
    //   "contextWindowTokens": 200000,
    // },
    // {
    //   "id": "system:opencode-go:deepseek-v4.1-flash",
    //   "provider": "opencode-go",
    //   "providerModelId": "deepseek-v4.1-flash",
    //   "name": "DeepSeek V4.1 Flash",
    //   "description": "Low-cost reasoning model on the OpenCode Go subscription.",
    //   "contextWindowTokens": 200000,
    //   "reasoning": {
    //     "effortLevels": ["low", "medium", "high"],
    //     "defaultEffort": "medium"
    //   },
    // },
    // --- opencode-go block: end ---
  ],

  // Optional declared embedding models, reusing a providers[] connection
  // above. Declaring one and selecting it below is the entire off-by-default
  // contract: with neither set, search behavior is unchanged.
  // "embeddingModels": [
  //   {
  //     "id": "openai:text-embedding-3-large",
  //     "provider": "openai",
  //     "providerModelId": "text-embedding-3-large",
  //     // TODO: make non-required
  //     "dimensions": 3072
  //   }
  // ],

  // Per-corpus intended-embedding-model selection. Unset (default) means no
  // embedding work is scheduled for that corpus.
  // "search": {
  //   "chats": {
  //     "embeddingModelId": "openai:text-embedding-3-large"
  //   }
  // },

  // Run limits. Interpolated numbers must be whole-value quoted tokens.
  "runs": {
    // Reserved from the context window when checking request fit.
    "maxOutputTokens": null,
    // pg-boss worker-liveness window (minimum 10 seconds).
    "heartbeatSeconds": "{env:RUN_HEARTBEAT_SECONDS:-15}",
    // Wall-clock budget for an active run.
    "timeoutSeconds": "{env:RUN_TIMEOUT_SECONDS:-900}",
  },

  "http": {
    // Leave unset unless the API runs behind a trusted reverse proxy.
    "trustProxy": "{env:TRUST_PROXY:-}",
  },

  // Database connection-pool size.
  "db": {
    "poolSize": "{env:DB_POOL_SIZE:-10}",
  },

  // Optional private root for server-managed Knowledge Space directories.
  // The value must resolve to an absolute path. Loading this setting does not
  // require the path to exist or be mounted; provisioning creates one stable-ID
  // child per owner. Mount the same logical children read-only into every runs
  // consumer and with write access only where provisioning is served.
  // "knowledge": {
  //   "root": "{env:KNOWLEDGE_ROOT}",
  // },

  // Optional operator skill catalog. Each entry is a collection directory whose
  // immediate child directories are Agent Skills packages (pdf/SKILL.md).
  // Later entries override earlier entries by package name. Entries are
  // literal, intentionally public paths: interpolation is rejected here.
  // Relative entries resolve against this file's directory. See docs/skills.md.
  // "skills": {
  //   "directories": ["/opt/skills", "~/.agents/skills"]
  // },

  // Empty allowed disables tools. MCP ids are mcp__<server>__<tool>.
  // Exact ids are safer; use mcp__<server>__* only for an entirely read-only server.
  "tools": {
    // Built-in or discovered MCP tool ids to allow. To enable Knowledge after
    // mounting the root above, add "knowledge_search" and "read"; search
    // returns a kb:// locator that "read" opens. "knowledge_read" was removed
    // and now fails boot as an unknown id.
    // Allowlisting search_conversations makes complete canonical projection
    // coverage a startup gate. Add conversation_read independently for exact
    // line reads; see docs/conversation-recall.md.
    "allowed": ["search_conversations"],
    // Optional whole-file replacements for llame-owned tool descriptions,
    // keyed by registered tool id (bash, conversation_read, edit,
    // knowledge_search, read, search_conversations, write); MCP ids are
    // rejected. A models[].toolPromptFiles entry above wins over this one,
    // which wins over the packaged default. Paths are literal, resolve against
    // this file, and are read when an execution process starts — editing one
    // needs a restart. See docs/tool-prompts.md.
    // "promptFiles": { "search_conversations": "./prompts/search.md" },
    // Allow/reject rules per exact tool id. There is NO built-in policy:
    // omitting this property rejects every call. This block is the recommended
    // portable map — the seven code-owned tools, each with a whole-tool allow
    // plus destructive-command and credential-locator rejects — copy it (or
    // replace it with your own). A supplied map is the complete policy: list
    // every group you intend to keep, and note that `{}` rejects every call.
    // MCP tools need an explicit group here; permission rules never change tool
    // visibility. Regex values are engine input; operator JSON must escape
    // backslashes and any interpolation-looking opening brace.
    "permissions": {
      "bash": {
        "allow": true,
        "reject": [
          {
            "field": "command",
            "regex": "(^|[^A-Za-z0-9_])(sudo|shutdown|reboot|halt|poweroff|mkfs([.][A-Za-z0-9_-]+)?)(\\s|$)"
          },
          {
            "field": "command",
            "regex": "\\brm\\s+(?:(?:-[A-Za-z]*[rR][A-Za-z]*[fF][A-Za-z]*|-[A-Za-z]*[fF][A-Za-z]*[rR][A-Za-z]*|-[A-Za-z]*[rR][A-Za-z]*\\s+-[A-Za-z]*[fF][A-Za-z]*|-[A-Za-z]*[fF][A-Za-z]*\\s+-[A-Za-z]*[rR][A-Za-z]*|--recursive\\s+(?:--force|-f)|--force\\s+(?:--recursive|-r))\\s+(?:--no-preserve-root\\s+)?|--no-preserve-root\\s+(?:-[A-Za-z]*[rR][A-Za-z]*[fF][A-Za-z]*|-[A-Za-z]*[fF][A-Za-z]*[rR][A-Za-z]*|-[A-Za-z]*[rR][A-Za-z]*\\s+-[A-Za-z]*[fF][A-Za-z]*|-[A-Za-z]*[fF][A-Za-z]*\\s+-[A-Za-z]*[rR][A-Za-z]*|--recursive\\s+(?:--force|-f)|--force\\s+(?:--recursive|-r))\\s+)(?:--\\s+)?['\"]?(?://?\\*?|~(?:\\*|//?\\*?)?|\\$HOME(?:/\\*?)?|\\$\\{{HOME\\}(?://?\\*?)?)['\"]?($|[\\s;&|])"
          },
          {
            "field": "command",
            "regex": "\\bdd\\s+[^\\r\\n;&|]*\\bof=/dev/"
          },
          {
            "field": "command",
            "literal": "diskutil erase"
          },
          {
            "field": "command",
            "literal": "diskutil apfs delete"
          },
          {
            "field": "command",
            "literal": "git reset --hard"
          },
          {
            "field": "command",
            "literal": "chmod -R 777"
          },
          {
            "field": "command",
            "regex": "\\b(curl|wget)\\s+[^\\r\\n;|]*\\x7c\\s*(ba|z|da|k)?sh(\\s|$)"
          }
        ]
      },
      "read": {
        "allow": true,
        "reject": [
          {
            "field": "path",
            "regex": "(^|[/\\\\])(\\.ssh|\\.aws|\\.azure|\\.gnupg|\\.kube)([/\\\\]|$|:)"
          },
          {
            "field": "path",
            "regex": "(^|[/\\\\])(\\.git-credentials|\\.npmrc|\\.pypirc)([/\\\\]|$|:)"
          },
          {
            "field": "path",
            "regex": "(^|[/\\\\])(\\.docker[/\\\\]config\\.json|\\.gem[/\\\\]credentials|\\.config[/\\\\]gh)([/\\\\]|$|:)"
          },
          {
            "field": "path",
            "regex": "(^|[/\\\\])\\.env($|:|\\.(local|development|production|staging|test)(\\.local)?($|:))"
          }
        ]
      },
      "edit": {
        "allow": true,
        "reject": [
          {
            "field": "path",
            "regex": "(^|[/\\\\])(\\.ssh|\\.aws|\\.azure|\\.gnupg|\\.kube)([/\\\\]|$|:)"
          },
          {
            "field": "path",
            "regex": "(^|[/\\\\])(\\.git-credentials|\\.npmrc|\\.pypirc)([/\\\\]|$|:)"
          },
          {
            "field": "path",
            "regex": "(^|[/\\\\])(\\.docker[/\\\\]config\\.json|\\.gem[/\\\\]credentials|\\.config[/\\\\]gh)([/\\\\]|$|:)"
          }
        ]
      },
      "write": {
        "allow": true,
        "reject": [
          {
            "field": "path",
            "regex": "(^|[/\\\\])(\\.ssh|\\.aws|\\.azure|\\.gnupg|\\.kube)([/\\\\]|$|:)"
          },
          {
            "field": "path",
            "regex": "(^|[/\\\\])(\\.git-credentials|\\.npmrc|\\.pypirc)([/\\\\]|$|:)"
          },
          {
            "field": "path",
            "regex": "(^|[/\\\\])(\\.docker[/\\\\]config\\.json|\\.gem[/\\\\]credentials|\\.config[/\\\\]gh)([/\\\\]|$|:)"
          }
        ]
      },
      "knowledge_search": {
        "allow": true
      },
      "search_conversations": {
        "allow": true
      },
      "conversation_read": {
        "allow": true
      }
    },
    // Maximum tool-requesting steps per run.
    "maxStepsPerRun": 100,
    // Per-tool-call timeout in seconds.
    "callTimeoutSeconds": 120,
  },

  // Optional worker-profile concurrency overrides. See docs/scaling.md.
  // "workers": {
  //   "all": { "runs": 4 },
  //   "heavy": { "search-reindex": 2 }
  // }
}
