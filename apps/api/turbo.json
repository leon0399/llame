{
  "$schema": "https://turbo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "outputs": ["dist/**", "openapi.json"],
      // generate-openapi.js boots the app, and configureApp()/the auth cookie
      // config hard-require these in production. Pass-through (not `env`):
      // they must reach the task under strict mode but don't change dist/ or
      // the OpenAPI document, so they stay out of the cache hash.
      "passThroughEnv": ["WEB_ORIGIN", "SESSION_COOKIE_DOMAIN"]
    },
    // Never cached: these run against live external state (a real Postgres,
    // a real model endpoint) that turbo's hash cannot see — a stale cached
    // PASS would look identical to a real, current result.
    "test:integration": {
      "cache": false
    },
    "test:evals": {
      "cache": false
    },
    // Checks consume built dependency exports. Build the declared graph directly
    // with: pnpm exec turbo run build --filter=api^... --concurrency=1
    "dev": { "dependsOn": ["^build"] },
    "lint": { "dependsOn": ["^build"] },
    "typecheck": { "dependsOn": ["^build"] },
    "test": { "dependsOn": ["^build"] },
    "test:coverage": { "dependsOn": ["^build"] }
  }
}
