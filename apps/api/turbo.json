{
  "$schema": "https://turbo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "outputs": ["dist/**", "openapi.json"],
      // generate-openapi.js boots the app, and configureApp()/the auth cookie
      // config hard-require these in production. Pass-through (not `env`):
      // they must reach the task under strict mode but don't change dist/ or
      // the OpenAPI document, so they stay out of the cache hash.
      "passThroughEnv": ["WEB_ORIGIN", "SESSION_COOKIE_DOMAIN"]
    },
    // Never cached: these run against live external state (a real Postgres,
    // a real model endpoint) that turbo's hash cannot see — a stale cached
    // PASS would look identical to a real, current result.
    // The Machine SSH integration suite copies the built llame-machine bundle
    // into its sshd container, so the integration-bearing tasks build it first.
    "test:integration": {
      "cache": false,
      "dependsOn": ["machine#build"]
    },
    "test:coverage": {
      "cache": false,
      "dependsOn": ["machine#build"]
    },
    "test:evals": {
      "cache": false
    },
    // This workspace consumes @workspace/config-interpolation as built dist
    // (exports → ./dist), so its checks need the upstream build first — the
    // root "nothing tests consume is built" rule has an exception here.
    // Local equivalent: pnpm --filter @workspace/config-interpolation build
    // (bypasses turbo's cache entirely).
    "dev": { "dependsOn": ["^build"] },
    "lint": { "dependsOn": ["^build"] },
    "typecheck": { "dependsOn": ["^build"] },
    "test": { "dependsOn": ["^build"] }
  }
}
