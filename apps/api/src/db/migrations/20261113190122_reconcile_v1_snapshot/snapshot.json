  "deltas": [
    {
      "op": "alter",
      "key": "columns\u0000[\"public\",\"knowledge_spaces\",\"created_at\"]",
      "set": {
        "type": "timestamp(3) with time zone"
      }
    },
    {
      "op": "alter",
      "key": "columns\u0000[\"public\",\"knowledge_spaces\",\"updated_at\"]",
      "set": {
        "type": "timestamp(3) with time zone"
      }
    },
    {
      "op": "alter",
      "key": "indexes\u0000[\"public\",\"messages_chat_absorbed_through_seq_uidx\"]",
      "set": {
        "where": "\"absorbed_through_seq\" IS NOT NULL"
      }
    },
    {
      "op": "alter",
      "key": "indexes\u0000[\"public\",\"project_repositories_owner_project_primary_uidx\"]",
      "set": {
        "where": "\"is_primary\""
      }
    },
    {
      "op": "alter",
      "key": "checks\u0000[\"public\",\"messages\",\"messages_seq_positive\"]",
      "set": {
        "value": "\"seq\" > 0"
      }
    },
    {
      "op": "alter",
      "key": "checks\u0000[\"public\",\"chats\",\"chats_workspace_detach_reason_check\"]",
      "set": {
        "value": "\"workspace_detach_reason\" IS NULL OR \"workspace_detach_reason\" IN ('executor_mismatch', 'executor_absent', 'root_missing', 'root_moved', 'permission_rejected', 'tool_not_allowed')"
      }
    },
    {
      "op": "alter",
      "key": "checks\u0000[\"public\",\"runs\",\"runs_permission_mode_check\"]",
      "set": {
        "value": "\"permission_mode\" IN ('default', 'bypass', 'read-only')"
      }
    },
    {
      "op": "alter",
      "key": "checks\u0000[\"public\",\"messages\",\"messages_checkpoint_boundary_check\"]",
      "set": {
        "value": "(\"role\"::text = 'checkpoint') = (\"absorbed_through_seq\" IS NOT NULL)"
      }
    },
    {
      "op": "alter",
      "key": "checks\u0000[\"public\",\"media_objects\",\"media_objects_shape\"]",
      "set": {
        "value": "(\"media_type\" <> 'application/pdf'\n        AND \"width\" IS NOT NULL AND \"height\" IS NOT NULL\n        AND \"model_media_type\" IS NOT NULL AND \"model_width\" IS NOT NULL\n        AND \"model_height\" IS NOT NULL AND \"model_byte_size\" IS NOT NULL\n        AND \"page_count\" IS NULL)\n      OR (\"media_type\" = 'application/pdf'\n        AND \"page_count\" IS NOT NULL AND \"page_count\" BETWEEN 1 AND 100\n        AND \"width\" IS NULL AND \"height\" IS NULL\n        AND \"model_media_type\" IS NULL AND \"model_width\" IS NULL\n        AND \"model_height\" IS NULL AND \"model_byte_size\" IS NULL)"
      }
    },
    {
      "op": "alter",
      "key": "checks\u0000[\"public\",\"machines_status\",\"machines_status_name_check\"]",
      "set": {
        "value": "\"name\" ~ '^[a-z0-9-]{1,63}$'"
      }
    },
    {
      "op": "alter",
      "key": "checks\u0000[\"public\",\"machines_status\",\"machines_status_failure_reason_check\"]",
      "set": {
        "value": "\"last_failure_reason\" IS NULL OR \"last_failure_reason\" IN ('unreachable', 'host_key_mismatch', 'auth_failed', 'incompatible_version', 'session_lost')"
      }
    },
    {
      "op": "alter",
      "key": "checks\u0000[\"public\",\"checkouts\",\"checkouts_kind_check\"]",
      "set": {
        "value": "\"kind\" IN ('main', 'worktree')"
      }
    },
    {
      "op": "alter",
      "key": "checks\u0000[\"public\",\"checkouts\",\"checkouts_origin_check\"]",
      "set": {
        "value": "\"origin\" IN ('registered', 'adopted', 'created')"
      }
    },
    {
      "op": "alter",
      "key": "checks\u0000[\"public\",\"checkouts\",\"checkouts_worktree_parent_check\"]",
      "set": {
        "value": "(\"kind\" = 'worktree') = (\"parent_checkout_id\" IS NOT NULL)"
      }
    },
    {
      "op": "alter",
      "key": "checks\u0000[\"public\",\"checkouts\",\"checkouts_worktree_base_check\"]",
      "set": {
        "value": "\"kind\" = 'main' OR \"worktree_base\" IS NULL"
      }
    },
    {
      "op": "alter",
      "key": "checks\u0000[\"public\",\"project_repositories\",\"project_repositories_isolation_check\"]",
      "set": {
        "value": "\"isolation\" IN ('inherit', 'always_worktree', 'never')"
      }
    },
    {
      "op": "alter",
      "key": "checks\u0000[\"public\",\"chat_creation_records\",\"chat_creation_records_attempts_check\"]",
      "set": {
        "value": "jsonb_typeof(\"attempts\") = 'array'"
      }
    },
    {
      "op": "alter",
      "key": "checks\u0000[\"public\",\"runs\",\"runs_follow_up_action_check\"]",
      "set": {
        "value": "\"follow_up_action\" IS NULL OR \"follow_up_action\" IN ('continue', 'regenerate')"
      }
    }
  ]
}
