          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Come move, meet other women in the field, and start your Sunday feeling good. We’ll have a matcha bar too, so grab a drink before or after class!",
              "type": "text"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [{ "text": "Sunday, 10/18", "type": "text" }]
        },
        {
          "type": "paragraph",
          "content": [{ "text": "10:00 to 11:00am", "type": "text" }]
        },
        {
          "type": "paragraph",
          "content": [{ "text": "Mountain View, CA", "type": "text" }]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "text": "All levels welcome, no Pilates experience needed, and BYOM(Bring Your Own Mat!).",
              "type": "text"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "text": "We’re keeping it exclusive with just 20 spots, so request your spot early.",
              "type": "text"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [{ "text": "See you there!", "type": "text" }]
