{
  "name": "api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build && node dist/instance-config/prompt-built-runtime.contract.js && node dist/generate-openapi.js && prettier --write --log-level warn openapi.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "dev": "nest start --watch",
    "dev:studio": "drizzle-kit studio",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "start:worker": "nest start --entryFile worker",
    "start:worker:dev": "nest start --entryFile worker --watch",
    "start:worker:prod": "node dist/worker",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e",
    "test:evals": "RUN_MODEL_EVALS=1 vitest run --project e2e qa-evals",
    "db:generate": "drizzle-kit generate && prettier --write --log-level warn \"src/db/migrations/meta/**/*.json\"",
    "db:migrate": "npx tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:check": "drizzle-kit check",
    "db:up": "drizzle-kit up"
  },
  "dependencies": {
    "@ai-sdk/openai": "3.0.79",
    "@knaadh/nestjs-drizzle-postgres": "^1.2.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.18",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.4.4",
    "@nestjs/throttler": "^6.5.0",
    "@wavezync/nestjs-pgboss": "^6.0.0",
    "ai": "catalog:",
    "ajv": "^8.18.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.0.0",
    "drizzle-orm": "^0.45.2",
    "handlebars": "4.7.9",
    "jsonc-parser": "^3.3.1",
    "pg-boss": "^12.24.1",
    "pino": "^10.3.1",
    "postgres": "^3.4.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^14.0.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@ai-sdk/provider": "3.0.13",
    "@ai-sdk/provider-utils": "4.0.34",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.10.7",
    "@types/express": "^5.0.0",
    "@types/node": "catalog:",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "@typescript/native-preview": "catalog:",
    "drizzle-kit": "^0.31.4",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "^0.24.0",
    "prettier": "catalog:",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "unplugin-swc": "1.5.9",
    "vitest": "catalog:"
  }
}
