{
  "name": "api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build && node dist/instance-config/prompt-built-runtime.contract.js && node dist/generate-openapi.js && prettier --write --log-level warn openapi.json",
    "db:check": "drizzle-kit check",
    "db:generate": "drizzle-kit generate && prettier --write --log-level warn \"src/db/migrations/meta/**/*.json\"",
    "db:migrate": "npx tsx src/db/migrate.ts",
    "db:pull": "drizzle-kit pull",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:up": "drizzle-kit up",
    "dev": "nest start --watch",
    "dev:studio": "drizzle-kit studio",
    "format": "prettier --write \"src/**/*.ts\" \"evals/**/*.ts\"",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives",
    "lint:fix": "oxlint --deny-warnings --fix",
    "search:backfill": "npx tsx src/search/operations/cli.ts backfill",
    "search:coverage": "npx tsx src/search/operations/cli.ts coverage",
    "search:projection-coverage": "npx tsx src/search/operations/cli.ts projection-coverage",
    "search:prune": "npx tsx src/search/operations/cli.ts prune",
    "search:retry-failed": "npx tsx src/search/operations/cli.ts retry-failed",
    "start": "nest start",
    "start:debug": "nest start --debug --watch",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "start:worker": "nest start --entryFile worker",
    "start:worker:dev": "nest start --entryFile worker --watch",
    "start:worker:prod": "node dist/worker",
    "test": "vitest run --project unit",
    "test:coverage": "vitest run --coverage && crap-typescript --threshold 42 --format none --exclude 'src/db/migrations/**' --exclude 'src/testing/**' src",
    "test:evals": "RUN_MODEL_EVALS=1 vitest run --project integration qa-evals",
    "test:evals:mcp-web-search": "RUN_MCP_WEB_SEARCH_EVAL=1 vitest run --project mcp-live-eval",
    "test:integration": "vitest run --project integration",
    "test:mutation": "pnpm --filter @workspace/config-interpolation --filter @workspace/runtime-safety --filter @workspace/tool-runtime --filter @workspace/knowledge-filesystem build && stryker run",
    "test:mutation:aggregate": "node ../../scripts/mutation-sharding.mjs aggregate",
    "test:mutation:check": "node ../../scripts/mutation-sharding.mjs aggregate --threshold 80 --expected-shards 8 reports/mutation-shards/*/mutation.json",
    "test:mutation:dry": "pnpm --filter @workspace/config-interpolation --filter @workspace/runtime-safety --filter @workspace/tool-runtime --filter @workspace/knowledge-filesystem build && stryker run --dryRunOnly",
    "test:mutation:shard": "pnpm --filter @workspace/config-interpolation --filter @workspace/runtime-safety --filter @workspace/tool-runtime --filter @workspace/knowledge-filesystem build && node ../../scripts/mutation-sharding.mjs run",
    "test:mutation:tooling": "node --test ../../scripts/mutation-sharding.test.mjs",
    "test:watch": "vitest --project unit",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@ai-sdk/mcp": "catalog:",
    "@ai-sdk/openai": "3.0.97",
    "@knaadh/nestjs-drizzle-postgres": "^1.2.0",
    "@modelcontextprotocol/sdk": "catalog:",
    "@nestjs/common": "^11.1.29",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.18",
    "@nestjs/platform-express": "^11.1.29",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/throttler": "^6.5.0",
    "@wavezync/nestjs-pgboss": "^6.0.0",
    "@workspace/config-interpolation": "workspace:*",
    "ai": "catalog:",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.0.0",
    "drizzle-orm": "^0.45.2",
    "handlebars": "4.7.9",
    "jsonc-parser": "^3.3.1",
    "pg-boss": "^12.24.1",
    "pino": "^10.3.1",
    "postgres": "^3.4.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "catalog:",
    "@workspace/runtime-safety": "workspace:*",
    "@workspace/tool-runtime": "workspace:*",
    "@workspace/knowledge-filesystem": "workspace:*"
  },
  "devDependencies": {
    "@ai-sdk/provider": "3.0.15",
    "@ai-sdk/provider-utils": "4.0.46",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.0.1",
    "@stryker-mutator/core": "catalog:",
    "@stryker-mutator/typescript-checker": "catalog:",
    "@stryker-mutator/vitest-runner": "catalog:",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.10.7",
    "@testcontainers/postgresql": "12.0.4",
    "@types/express": "^5.0.0",
    "@types/node": "catalog:",
    "@types/supertest": "^7.2.1",
    "@typescript/native-preview": "catalog:",
    "@barney-media/crap-typescript": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "drizzle-kit": "^0.31.4",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "prettier": "catalog:",
    "supertest": "^7.2.2",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "unplugin-swc": "1.5.9",
    "vitest": "catalog:"
  }
}
