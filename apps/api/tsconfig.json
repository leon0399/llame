{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "lib": [
      "ES2023",
      "DOM",
      "WebWorker.ImportScripts",
      "ScriptHost",
      "DOM.Iterable",
      "DOM.AsyncIterable",
      "ES2024.Promise"
    ],
    "sourceMap": true,
    "outDir": "./dist",
    "types": ["node", "vitest/globals"],
    "skipLibCheck": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false
  },
  // Without this, the implicit include pulls dist/**/*.d.ts into the program —
  // tsc (`typecheck`) and tsgolint (type-aware lint) then double the file set
  // and can OOM on memory-constrained machines after a local build.
  "exclude": ["node_modules", "dist"]
}
