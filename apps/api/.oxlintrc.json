{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["../../.oxlintrc.json"],
  "options": { "typeAware": true },
  "env": { "node": true, "vitest": true },
  "ignorePatterns": ["dist/**", "src/db/migrations/**"],
  "overrides": [
    {
      // Nest DI and decorated handlers own these signatures.
      "files": [
        "src/chats/chat-loop.service.ts",
        "src/runs/run-execution.service.ts",
        "src/runs/runs-worker.service.ts",
        "src/runs/runs.controller.ts",
        "src/search/search-embed.worker.ts",
        "src/search/search-reindex.worker.ts",
        "src/tools/runner.ts"
      ],
      "rules": {
        "max-params": "off"
      }
    },
    {
      // Required by jsonc-parser's JSONVisitor callback contract.
      "files": ["src/instance-config/config-loader.ts"],
      "rules": {
        "max-params": "off"
      }
    },
    {
      // Cohesive execution, transaction, SQL, RLS, and fixture flows whose
      // state cannot cross a helper boundary safely.
      "files": [
        "src/chats/messages-repository.ts",
        "src/compaction/compaction.service.ts",
        "src/db/schema/identity.ts",
        "src/runs/run-execution.service.ts",
        "src/runs/run-stream-bridge.ts",
        "src/runs/runs-worker.service.ts",
        "src/runs/runs.controller.ts",
        "src/runs/scripted-model-client.ts",
        "src/runs/worker-harness.ts"
      ],
      "rules": {
        "max-lines-per-function": "off"
      }
    },
    {
      // Cohesive state and security modules with no stable split boundary.
      "files": [
        "src/instance-config/config-loader.ts",
        "src/instance-config/prompt-loader.ts",
        "src/knowledge/knowledge-tools.ts",
        "src/mcp/mcp-runtime.service.ts",
        "src/runs/run-execution.service.ts"
      ],
      "rules": {
        "max-lines": "off"
      }
    },
    {
      // Queue variance escape is documented at the boundary in queue.ts.
      "files": ["src/queue/pgboss-queue.service.ts", "src/queue/queue.ts"],
      "rules": {
        "typescript/no-explicit-any": "off"
      }
    }
  ]
}
