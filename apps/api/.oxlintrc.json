{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // Every rule lives in ../../.oxlintrc.json. This file adds only what is local.
  "extends": ["../../.oxlintrc.json"],
  "options": { "typeAware": true },
  "env": { "node": true, "vitest": true },
  "ignorePatterns": ["dist/**", "src/db/migrations/**"],
  "overrides": [
    {
      // Spawned as a bare `node` script by the stdio MCP client tests, so it
      // must stay plain JS and sits outside the TS program. Type-aware rules
      // have no types to work from and flag every read of its JSON-parsed
      // config; correctness rules still apply.
      "files": ["src/mcp/mcp-stdio-test-fixture.mjs"],
      "rules": {
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-argument": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-return": "off"
      }
    }
  ]
}
