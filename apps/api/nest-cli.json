{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "generateOptions": {
    "spec": false
  },
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      "instance-config/llame.config.schema.json",
      "prompts/**/*.md",
      "**/prompts/**/*.md"
    ],
    "watchAssets": true
  }
}
