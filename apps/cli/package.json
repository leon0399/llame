{
  "name": "cli",
  "version": "0.0.1",
  "private": true,
  "description": "llame terminal: standalone personal runtime and remote API client",
  "bin": {
    "llame": "bin/llame.cjs"
  },
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node bin/llame.cjs",
    "test": "node --test tests/*.test.mjs tests/integration/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives",
    "lint:fix": "oxlint --deny-warnings --fix",
    "package:standalone": "node scripts/package.mjs",
    "test:core": "node --test tests/*.test.mjs",
    "test:mcp": "node --test tests/integration/*.test.mjs"
  },
  "dependencies": {
    "@workspace/config-interpolation": "workspace:*",
    "@workspace/runtime-safety": "workspace:*",
    "@workspace/tool-runtime": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@workspace/config-typescript": "workspace:*",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  }
}
