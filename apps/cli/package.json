{
  "name": "cli",
  "version": "0.0.1",
  "private": true,
  "description": "llame's experimental local coding-harness CLI: a single-owner agent loop over the extracted @workspace/harness core.",
  "bin": {
    "llame": "./dist/main.js"
  },
  "scripts": {
    "dev": "tsx src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@workspace/config": "workspace:*",
    "@workspace/harness": "workspace:*",
    "ai": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@workspace/config-typescript": "workspace:*",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
