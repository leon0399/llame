{
  "name": "machine",
  "version": "0.0.2",
  "private": true,
  "description": "llame-machine Rust daemon.",
  "scripts": {
    "build": "node scripts/build-daemon.mjs",
    "lint": "cargo fmt --all --check && cargo clippy --locked --workspace --all-targets",
    "test": "cargo test --locked --workspace",
    "test:coverage": "cargo test --locked --workspace",
    "build:release": "node scripts/build-daemon.mjs --release-targets"
  }
}
