{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // Every rule lives in ../../.oxlintrc.json. This file adds only what is local.
  "extends": ["../../.oxlintrc.json"],
  "env": { "browser": true, "node": true },
  // lib/api/generated is Orval output from apps/api/openapi.json. Its
  // no-unsafe-dictionary-type reports come from OpenAPI schemas declaring
  // additionalProperties: true; the fix is the schema or the generator
  // config, never the emitted file, which the next regeneration overwrites.
  // Same reasoning as apps/api ignoring src/db/migrations.
  "ignorePatterns": [".next/**", "next-env.d.ts", "lib/api/generated/**"]
}
