# apps/web environment — copy to .env.local for local dev:
#   cp apps/web/.env.example apps/web/.env.local
#
# Public because browser code calls apps/api directly.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Sentry, inlined at build time. An unset DSN disables reporting; an unset
# environment tags events `local`.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
