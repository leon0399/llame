{
  "name": "web",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "generate:client": "orval --config orval.config.ts",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives",
    "lint:fix": "oxlint --deny-warnings --fix",
    "start": "next start",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage && crap-typescript --threshold 42 --format none --exclude 'lib/api/generated/**' app lib components contexts hooks utils",
    "test:watch": "vitest",
    "typecheck": "next typegen && tsgo --noEmit"
  },
  "dependencies": {
    "@ai-sdk/react": "3.0.259",
