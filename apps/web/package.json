    "@typescript/native-preview": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@workspace/config-typescript": "workspace:*",
    "jsdom": "^28.1.0",
    "orval": "8.24.0",
    "oxlint": "catalog:",
    "storybook": "catalog:",
    "typescript": "catalog:",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "catalog:"
  }
