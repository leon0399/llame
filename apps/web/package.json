    "@workspace/ui": "workspace:*",
    "ai": "catalog:",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.23.6",
    "js-cookie": "^3.0.7",
    "lucide-react": "catalog:",
    "next": "catalog:",
    "next-themes": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "catalog:",
    "use-stick-to-bottom": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@barney-media/crap-typescript": "catalog:",
    "@storybook/nextjs-vite": "catalog:",
