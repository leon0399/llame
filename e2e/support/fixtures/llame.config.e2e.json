{
  "$schema": "../../../apps/api/src/instance-config/llame.config.schema.json",
  // E2E instance config (referenced via LLAME_CONFIG_PATH in
  // playwright.config.ts). Model selection is by opaque catalog id; the mock
  // model server answers any /chat/completions regardless of the provider
  // model id, so any valid catalog ids work here.
  "defaults": {
    "modelId": "system:openai:gpt-5.4-mini",
    "titleGenerationModelId": "system:openai:gpt-5.4-nano"
  },
  // Provider connection + executable catalog (providers-and-models-as-code,
  // #167): defaults.modelId/titleGenerationModelId above must reference a
  // models[].id or startup fails. key/baseUrl route to the mock model server
  // via the same OPENAI_API_KEY/OPENAI_BASE_URL env vars playwright.config.ts
  // already sets on the api webServer.
  "providers": [
    {
      "id": "mock",
      "type": "openai",
      "key": "{env:OPENAI_API_KEY:-}",
      "baseUrl": "{env:OPENAI_BASE_URL:-}"
    }
  ],
  "models": [
    {
      "id": "system:openai:gpt-5.4-mini",
      "provider": "mock",
      "providerModelId": "gpt-5.4-mini",
      "contextWindowTokens": 400000
    },
    {
      "id": "system:openai:gpt-5.4-nano",
      "provider": "mock",
      "providerModelId": "gpt-5.4-nano",
      "contextWindowTokens": 400000
    },
    {
      "id": "e2e:context-target-carmine",
      "provider": "mock",
      "providerModelId": "context-target-carmine",
      "name": "E2E Context Target",
      "systemPromptFile": "./prompts/context-target.md",
      "contextWindowTokens": 400000
    }
  ],
  // Deterministic local Streamable HTTP source for the browser MCP acceptance
  // case. The endpoint is supplied by Playwright so port overrides remain
  // isolated from this checked-in fixture configuration.
  "mcpServers": {
    "fixture_search": {
      "type": "streamable-http",
      "url": "{env:E2E_MCP_URL:-http://localhost:4304/mcp}"
    },
    // Local stdio server. The interpolated secret must be redacted out of both
    // the child's diagnostics and its tool result; the literal script path must
    // not be, or every call naming it would be refused.
    "fixture_local": {
      "type": "stdio",
      // `command` is literal on purpose. Interpolating it would make its
      // resolved value ("node") a protected value, and a protected value is
      // matched as a substring across all output — every `node:internal/...`
      // frame in a stack trace came back as `[REDACTED]:internal/...` when
      // this was written as a token. Interpolate credentials, not programs.
      "command": "node",
      // Relative to the api process's cwd (apps/api), not the repo root.
      "args": ["../../e2e/support/mcp-stdio-server.mjs"],
      "env": {
        "E2E_STDIO_MCP_SECRET": "{env:E2E_STDIO_MCP_SECRET:-stdio-e2e-secret}"
      }
    }
  },
  // Tool-calling loop (openspec/changes/tool-calling-loop): the e2e tool-loop
  // browser suite (e2e/web/chat/tool-loop.spec.ts) drives search_conversations
  // through the mock model server — it must be allowlisted for those tests
  // to see any tool activity at all.
  "tools": {
    "allowed": [
      "search_conversations",
      "knowledge_search",
      "knowledge_read",
      "mcp__fixture_search__search",
      "mcp__fixture_local__lookup"
    ]
  },
  "knowledge": {
    "root": "{env:E2E_KNOWLEDGE_ROOT:-/tmp/llame-e2e-knowledge}"
  },
  // fullyParallel browser workers need real `runs` concurrency (the default
  // profile's 1 backs up past assertion timeouts); poolSize >= concurrency
  // per docs/scaling.md.
  "workers": {
    "all": {
      "runs": 8
    }
  },
  "db": {
    "poolSize": 12
  }
}
