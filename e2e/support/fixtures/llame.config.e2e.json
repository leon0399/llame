{
  "$schema": "../../../apps/api/src/instance-config/llame.config.schema.json",
  // E2E instance config (referenced via LLAME_CONFIG_PATH in
  // playwright.config.ts). Model selection is by opaque catalog id; the mock
  // model server answers any /chat/completions regardless of the provider
  // model id, so any valid catalog ids work here.
  "defaults": {
    "selector": "system:openai:gpt-5.4-mini",
    "titleGenerationSelector": "system:openai:gpt-5.4-nano"
  },
  // Provider connection + executable catalog (providers-and-models-as-code,
  // #167): defaults.selector/titleGenerationSelector above must reference a
  // models[].id or a modelRoles key (`@` plus the key) or startup fails.
  // key/baseUrl route to the mock model server via the same
  // OPENAI_API_KEY/OPENAI_BASE_URL env vars playwright.config.ts already
  // sets on the api webServer. The mock answers /chat/completions only, so
  // this entry declares the Chat Completions wire, and its baseUrl is set by
  // that env var (required and non-blank for this type).
  "providers": [
    {
      "id": "mock",
      "type": "openai-completions",
      "key": "{env:OPENAI_API_KEY:-}",
      "baseUrl": "{env:OPENAI_BASE_URL:-}"
    }
  ],
  "models": [
    {
      "id": "system:openai:gpt-5.4-mini",
      "provider": "mock",
      "providerModelId": "gpt-5.4-mini",
      "contextWindowTokens": 400000
    },
    {
      "id": "system:openai:gpt-5.4-nano",
      "provider": "mock",
      "providerModelId": "gpt-5.4-nano",
      "contextWindowTokens": 400000
    },
    {
      "id": "e2e:context-target-carmine",
      "provider": "mock",
      "providerModelId": "context-target-carmine",
      "name": "E2E Context Target",
      "systemPromptFile": "./prompts/context-target.md",
      "contextWindowTokens": 400000
    },
    // Declares image input so the composer attaches images and Runs send them
    // (e2e/web/chat/vision-lightbox.spec.ts); the mock answers a request whose
    // last user turn carries an image with the vision fixture answer.
    {
      "id": "e2e:vision-viridian",
      "provider": "mock",
      "providerModelId": "vision-viridian",
      "name": "E2E Vision",
      "input": ["text", "image"],
      "contextWindowTokens": 400000
    },
    // PDF-only input exercises the composer without relying on image support.
    {
      "id": "e2e:pdf-input",
      "provider": "mock",
      "providerModelId": "pdf-input",
      "name": "E2E PDF",
      "input": ["text", "pdf"],
      "contextWindowTokens": 400000
    }
  ],
  // One role with two candidates, so `turn-actions.spec.ts` can fail a turn on
  // the primary and continue it on the next candidate. The mock model server
  // fails only the marked prompt on `gpt-5.4-mini`, so the role's second
  // candidate answers the continuation.
  "modelRoles": {
    "chat": {
      "candidates": [
        { "model": "system:openai:gpt-5.4-mini" },
        { "model": "system:openai:gpt-5.4-nano" }
      ]
    }
  },
  // Deterministic local Streamable HTTP source for the browser MCP acceptance
  // case. The endpoint is supplied by Playwright so port overrides remain
  // isolated from this checked-in fixture configuration.
  "mcpServers": {
    "fixture_search": {
      "type": "streamable-http",
      "url": "{env:E2E_MCP_URL:-http://localhost:4304/mcp}"
    },
    // Local stdio server. The interpolated secret must be redacted out of both
    // the child's diagnostics and its tool result; the literal script path must
    // not be, or every call naming it would be refused.
    "fixture_local": {
      "type": "stdio",
      // `command` is literal on purpose. Interpolating it would make its
      // resolved value ("node") a protected value, and a protected value is
      // matched as a substring across all output — every `node:internal/...`
      // frame in a stack trace came back as `[REDACTED]:internal/...` when
      // this was written as a token. Interpolate credentials, not programs.
      "command": "node",
      // Relative to the api process's cwd (apps/api), not the repo root.
      "args": ["../../e2e/support/mcp-stdio-server.mjs"],
      "env": {
        "E2E_STDIO_MCP_SECRET": "{env:E2E_STDIO_MCP_SECRET:-stdio-e2e-secret}"
      }
    }
  },
  // Tool-calling loop and conversation recall acceptance tests both drive
  // search_conversations through the mock model server; it must be allowlisted.
  // One declared Machine that never answers: chat-start-location.spec.ts proves
  // the composer disables an offline Machine with its reason and that a create
  // naming it answers `machine_unavailable` instead of guessing a fallback.
  // This process hosts `e2e-host` (no destination: it runs in process), which
  // also serves unbound Chats; the stored executor id is the Machine name.
  "machines": {
    "local": "e2e-host",
    "default": "e2e-host",
    "hosts": {
      "e2e-host": {},
      "e2e-offline": { "destination": "e2e-offline.invalid" }
    }
  },
  "tools": {
    "allowed": [
      "bash",
      "search_conversations",
      "knowledge_search",
      "read",
      "enter_workspace",
      "mcp__fixture_search__search",
      "mcp__fixture_local__lookup"
    ],
    // Explicit whole-map replacement: every allowed tool needs its own group
    // (MCP tools never receive an implicit one). Bash rejects one literal so the
    // permission-gate e2e can prove a rejected call continues the Run.
    "permissions": {
      "bash": {
        "allow": true,
        "reject": [{ "field": "command", "literal": "e2e-permission-denied" }]
      },
      "read": { "allow": true },
      "edit": { "allow": true },
      "write": { "allow": true },
      "knowledge_search": { "allow": true },
      // The project page composer creates chats bound to a throwaway clone (and
      // a worktree of it), which is the same path decision a Run makes.
      "enter_workspace": { "allow": true },
      "search_conversations": { "allow": true },
      "mcp__fixture_search__search": { "allow": true },
      "mcp__fixture_local__lookup": { "allow": true }
    }
  },
  "knowledge": {
    "root": "{env:E2E_KNOWLEDGE_ROOT:-/tmp/llame-e2e-knowledge}"
  },
  // fullyParallel browser workers need real `runs` concurrency (the default
  // profile's 1 backs up past assertion timeouts); poolSize >= concurrency
  // per docs/product/operator/scaling.md.
  "workers": {
    "all": {
      "runs": 8
    }
  },
  "db": {
    "poolSize": 12
  }
}
