          "input": {
            "content": "# Static checks over the SOURCE that need no build, browser or database — the\n# cheapest feedback in the pipeline, deliberately its own workflow so a\n# formatting nit reports separately from a failing test.\n#\n# Two shapes, both running in parallel:\n#\n#   workspace (matrix)  one _lint-workspace.yaml run per workspace → Oxlint,\n#                       each verdict standing alone so a red X names the\n#                       workspace that broke.\n#   global              the whole-repo checks that cannot be split per\n#                       workspace — Prettier, Markdown, OpenAPI, knip, jscpd,\n#                       complexity, and the root-file Oxlint pass — one runner,\n#                       one named step each.\n#\n# Only Oxlint decomposes cleanly per workspace (each package has its own `lint`\n# script and rule set). Prettier is one root config over the whole tree; knip\n# and jscpd need the full graph to judge dead code and duplication; the\n# complexity globs and the OpenAPI spec are cross-workspace. Splitting those\n# per workspace would either miss root-level files or duplicate one config N\n# times, so they stay global.\n#\n# The workflows themselves are linted by workflow-lint.yml (actionlint,\n# zizmor, pinact).\n#\n# Actions are pinned to commit SHAs (comment = the release tag they resolve to).\n\nname: Lint\n\non:\n  pull_request:\n  push:\n    branches: [master]\n\nconcurrency:\n  group: ${{ github.workflow }}-${{ github.ref }}\n  cancel-in-progress: true\n\npermissions:\n  contents: read\n\nenv:\n  TURBO_TELEMETRY_DISABLED: \"1\"\n\njobs:\n  workspace:\n    name: Workspace\n    strategy:\n      # One workspace's lint failure must not cancel the others — each red X is\n      # independent signal, like the mutation shards.\n      fail-fast: false\n      matrix:\n        # Every workspace with a `lint` script. config-typescript has none\n        # (types only), so it is absent by design, not omission.\n        workspace:\n          - apps/api\n          - apps/web\n          - apps/storybook\n          - packages/ui\n          - packages/config-interpolation\n          - packages/oxlint-plugin-anti-slop\n    uses: ./.github/workflows/_lint-workspace.yaml\n    with:\n      working-directory: ${{ matrix.workspace }}\n\n  global:\n    name: Global\n    runs-on: ubuntu-latest\n    timeout-minutes: 15\n    steps:\n      - uses: actions/checkout@9c091bb21b7c1c1d1991bb908d89e4e9dddfe3e0 # v7.0.0\n        with:\n          persist-credentials: false\n\n      - uses: ./.github/actions/setup\n\n      # Root-level source the workspace matrix never sees: the E2E suite and\n      # the Playwright config live outside any package.\n      - name: Oxlint (root)\n        run: pnpm lint:code:root\n\n      # Whole repo via the root .prettierignore — the same surface the\n      # lefthook pre-commit hook gates per staged file (#175).\n      - name: Format\n        run: pnpm run format:check\n\n      - name: Markdown\n        run: pnpm lint:markdown\n\n      - name: OpenAPI\n        run: pnpm lint:openapi\n\n      # Dead code and duplication are cross-workspace verdicts by nature.\n      - name: Dead code\n        run: pnpm lint:dead-code\n\n      - name: Duplicates\n        run: pnpm lint:duplicates\n\n      - name: Complexity\n        run: pnpm lint:complexity\n",
