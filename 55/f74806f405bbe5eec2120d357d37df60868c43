            "content": "/**\n * Windowed chat history browser e2e (#187).\n *\n * A chat far larger than one history page must open bottom-up on just the\n * newest window (no eager multi-page walk), land the reader at the newest\n * message, and load strictly-older pages endlessly as the reader scrolls\n * toward the top — holding the reading position steady across each prepend.\n */\n\nimport { expect, test } from \"../../support/fixtures\";\nimport { seedMessages } from \"./seed-messages\";\n\nconst ANSWER = \"Mocked answer from the e2e model server.\";\nconst SEEDED_COUNT = 130;\n// The chat's 2 real messages + the seeded rows.\nconst TOTAL_MESSAGES = 2 + SEEDED_COUNT;\nconst WINDOW = 100;\n\ntest.describe(\"chat history pagination (#187)\", () => {\n  test(\"opens on the newest window and loads older pages on upward scroll\", async ({\n    page,\n  }) => {\n    // Create a real chat through the app, then grow it far past one page.\n    await page.goto(\"/\");\n    await page\n      .getByPlaceholder(\"What would you like to know?\")\n      .fill(\"history pagination first turn\");\n    await page.getByRole(\"button\", { name: \"Send message\" }).click();\n    await expect(page.getByRole(\"log\").getByText(ANSWER)).toBeVisible({\n      timeout: 20_000,\n    });\n    await expect(page).toHaveURL(/\\/chat\\/[0-9a-f-]{36}$/, {\n      timeout: 15_000,\n    });\n    const chatId = new URL(page.url()).pathname.split(\"/\").at(-1);\n    if (!chatId) throw new Error(\"chat id missing from URL\");\n\n    seedMessages(chatId, SEEDED_COUNT);\n\n    await page.reload();\n    const log = page.getByRole(\"log\");\n    const messages = page.locator(\"[data-message-key]\");\n\n    // Bottom-up: the newest seeded turn is on screen with no scrolling…\n    await expect(log.getByText(`seeded turn ${SEEDED_COUNT}`)).toBeVisible({\n      timeout: 15_000,\n    });\n    // …and only the newest window was loaded — not the whole chat.\n    await expect(messages).toHaveCount(WINDOW);\n    await expect(\n      log.getByText(\"history pagination first turn\"),\n    ).toHaveCount(0);\n\n    // The initial window is seeded turns 31..130; \"seeded turn 31\" is the\n    // topmost loaded message. Wheel upward (real user scrolling — it also\n    // releases stick-to-bottom) until it is on screen, then record where it\n    // sits.\n    const anchor = log.getByText(\"seeded turn 31\");\n    await log.hover();\n    await expect(async () => {\n      await page.mouse.wheel(0, -4_000);\n      await expect(anchor).toBeVisible({ timeout: 250 });\n    }).toPass({ timeout: 20_000 });\n    const before = await anchor.boundingBox();\n    if (!before) throw new Error(\"anchor message has no bounding box\");\n\n    // Approaching the top arms the prefetch band: the next older page loads\n    // without any explicit control…\n    await page.mouse.wheel(0, -1_000);\n    await expect\n      .poll(() => messages.count(), { timeout: 15_000 })\n      .toBeGreaterThan(WINDOW);\n\n    // …and the prepend did not yank the reading position: the previously\n    // topmost message is still where the reader left it.\n    const after = await anchor.boundingBox();\n    if (!after) throw new Error(\"anchor message lost its bounding box\");\n    expect(Math.abs(after.y - before.y)).toBeLessThan(60);\n\n    // Keep scrolling: the walk continues page-by-page to the chat's very\n    // first message, then stops (no loader control left behind).\n    await expect(async () => {\n      await page.mouse.wheel(0, -4_000);\n      await expect(messages).toHaveCount(TOTAL_MESSAGES, { timeout: 500 });\n    }).toPass({ timeout: 30_000 });\n    await expect(async () => {\n      await page.mouse.wheel(0, -4_000);\n      await expect(\n        log.getByText(\"history pagination first turn\"),\n      ).toBeVisible({ timeout: 500 });\n    }).toPass({ timeout: 15_000 });\n  });\n});\n",
