            "content": "import { execFileSync } from \"node:child_process\";\n\n/**\n * Direct-DB bulk seed of chat messages (#187 windowed-history browser e2e).\n * The chat itself is created through the real app (UI send, like the other\n * chat specs) — only the long history is seeded directly: driving 100+ real\n * turns through the durable-run pipeline would take minutes where a single\n * insert is exact and instant. `seq` is a generated identity, so the seeded\n * rows land strictly after the chat's real messages in conversation order.\n *\n * Rows alternate user/assistant with a text part of `seeded turn N`\n * (N = 1..count), so specs can address any turn by its text. The actual\n * read remains the real, RLS-scoped `GET /chats/:id/messages` window walk.\n *\n * Same two connection paths as seed-compaction.ts: the throwaway-DB harness\n * seeds via `docker exec ... psql` as the `postgres` superuser; a\n * caller-supplied POSTGRES_URL seeds as that URL's app role and requires\n * ownerUserId so the insert runs under FORCE RLS.\n */\nexport function seedMessages(\n  chatId: string,\n  count: number,\n  ownerUserId?: string,\n): void {\n  const container = process.env.E2E_DB_CONTAINER ?? \"llame-e2e-postgres\";\n  const dbPort = process.env.E2E_DB_PORT ?? \"55433\";\n  const postgresUrl =\n    process.env.POSTGRES_URL ??\n    `postgres://app:app@localhost:${dbPort}/llame_e2e`;\n  const databaseName = new URL(postgresUrl).pathname.replace(/^\\//, \"\");\n\n  if (!Number.isInteger(count) || count < 1) {\n    throw new Error(`seedMessages count must be a positive integer: ${count}`);\n  }\n\n  const escape = (value: string) => value.replace(/'/g, \"''\");\n\n  const insert = `INSERT INTO messages (chat_id, role, parts)\n    SELECT '${escape(chatId)}'::uuid,\n           (CASE WHEN n % 2 = 1 THEN 'user' ELSE 'assistant' END)::message_role,\n           jsonb_build_array(jsonb_build_object('type', 'text', 'text', 'seeded turn ' || n))\n    FROM generate_series(1, ${count}) AS n;`;\n\n  if (process.env.POSTGRES_URL) {\n    if (!ownerUserId) {\n      throw new Error(\n        \"seedMessages requires ownerUserId when POSTGRES_URL is set\",\n      );\n    }\n    execFileSync(\n      \"psql\",\n      [\n        postgresUrl,\n        \"-v\",\n        \"ON_ERROR_STOP=1\",\n        \"-c\",\n        `BEGIN; SET LOCAL app.current_user_id = '${escape(ownerUserId)}'; ${insert} COMMIT;`,\n      ],\n      { stdio: \"inherit\" },\n    );\n    return;\n  }\n\n  execFileSync(\n    \"docker\",\n    [\n      \"exec\",\n      \"-i\",\n      container,\n      \"psql\",\n      \"-U\",\n      \"postgres\",\n      \"-d\",\n      databaseName,\n      \"-v\",\n      \"ON_ERROR_STOP=1\",\n      \"-c\",\n      insert,\n    ],\n    { stdio: \"inherit\" },\n  );\n}\n",
