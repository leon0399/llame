{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  // Prettier's width, which the code base is formatted to (Oxfmt defaults to 100).
  "printWidth": 80,
  // Prettier never sorted package.json; key order stays as authored.
  "sortPackageJson": false,
  // apps/api and packages/mcp-workspace keep their NestJS-style quoting.
  "overrides": [
    {
      "files": ["apps/api/**", "packages/mcp-workspace/**"],
      "options": { "singleQuote": true, "trailingComma": "all" },
    },
  ],
  // Oxfmt reads only the root .gitignore, so ignored files under apps/ and
  // packages/ are listed here too. node_modules and .git are always ignored.
  "ignorePatterns": [
    // Agent worktrees: full copies of the repo; never format or check these.
    ".claude/",
    // Vendored agent skills (third-party content; .claude/skills/* link here).
    ".agents/",

    // Build and tool output.
    "dist/",
    "build/",
    "out/",
    ".next/",
    ".turbo/",
    "coverage/",
    "apps/api/reports/mutation/",
    "storybook-static/",
    "playwright-report/",
    "test-results/",
    "packages/storybook-addon-visual-tests/test/.tmp/",

    // Local, gitignored files.
    "CLAUDE.local.md",
    "apps/api/llame.config.json",
    "apps/api/llame.config.jsonc",
    "apps/api/llame.config.yaml",
    "apps/api/llame.config.yml",
    "apps/api/llame.config.toml",
    "apps/web/next-env.d.ts",

    // Owned by external tools with their own canonical serialization.
    "pnpm-lock.yaml",
    // Generated visual-test baselines (baseline.json is written by the addon).
    "**/__screenshots__/",

    // Model-facing prompt assets: their exact bytes are the contract with the
    // provider. A formatter would reflow the prose and change what the model
    // reads.
    "apps/api/src/prompts/tools/",

    // Packaged prompt templates shipped with the app, not documentation, and
    // not replaceable by any operator: the same rule applies.
    "apps/api/src/chats/prompts/",
    "apps/api/src/compaction/prompts/",
    "apps/api/src/titles/prompts/",
    "apps/api/src/knowledge/prompts/",
    "apps/api/src/skills/prompts/",
    "apps/api/src/tools/prompts/",

    // Vendored from shadcn CLI (upstream serialization).
    "packages/ui/src/styles/shadcn.css",
    // Vendored Oxlint plugin; update from its pinned upstream source.
    "tools/oxlint/anti-slop/",
  ],
}
