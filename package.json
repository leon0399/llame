{
  "name": "llame",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "preinstall": "npx only-allow@1.2.1 pnpm",
    "prepare": "lefthook install",
    "build": "turbo run build",
    "dev": "turbo run dev dev:studio",
    "lint": "turbo run lint",
    "lint:root": "pnpm lint:anti-slop && oxlint --deny-warnings --report-unused-disable-directives --threads=1 e2e playwright.config.ts",
    "lint:anti-slop": "tsc -p tools/oxlint/anti-slop/tsconfig.json && node --import tsx tools/oxlint/anti-slop/rules/no-chained-type-assertions.test.ts",
    "lint:ast-grep": "ast-grep scan --error --no-ignore hidden .",
    "lint:markdown": "markdownlint-cli2",
    "test": "turbo run test",
    "test:storybook": "turbo run test:storybook",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write --cache .",
    "format:check": "prettier --check --cache .",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "db:logs": "docker compose logs -f postgres",
    "db:migrate": "pnpm --filter api db:migrate",
    "db:generate": "pnpm --filter api db:generate",
    "db:studio": "pnpm --filter api db:studio",
    "db:psql": "docker compose exec -e PGPASSWORD=app postgres psql -U app -d llame",
    "db:provision-rls": "docker compose exec -T -e PGPASSWORD=postgres postgres psql -U postgres -d llame -v ON_ERROR_STOP=1 < docker/postgres/rls-function-owner.sql"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.44.0",
    "@oxlint/plugins": "1.77.0",
    "@playwright/test": "catalog:",
    "@workspace/config-typescript": "workspace:*",
    "lefthook": "2.1.9",
    "markdownlint-cli2": "0.23.2",
    "oxlint": "catalog:",
    "prettier": "catalog:",
    "shadcn": "catalog:",
    "tsx": "catalog:",
    "turbo": "^2.10.4",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@10.34.4",
  "engines": {
    "node": ">=22.19"
  }
}
