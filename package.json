{
  "name": "llame",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter api db:generate",
    "db:logs": "docker compose logs -f postgres",
    "db:migrate": "pnpm --filter api db:migrate",
    "db:provision-rls": "docker compose exec -T -e PGPASSWORD=postgres postgres psql -U postgres -d llame -v ON_ERROR_STOP=1 < docker/postgres/rls-function-owner.sql",
    "db:psql": "docker compose exec -e PGPASSWORD=app postgres psql -U app -d llame",
    "db:reset": "docker compose down -v && docker compose up -d",
    "db:studio": "pnpm --filter api db:studio",
    "db:up": "docker compose up -d",
    "dev": "turbo run dev dev:studio",
    "format": "prettier --write --cache .",
    "format:check": "prettier --check .",
    "generate:api-client": "pnpm generate:api-schema && pnpm generate:web-client",
    "generate:api-schema": "pnpm --filter api build",
    "generate:web-client": "pnpm --filter web generate:client",
    "lint": "pnpm lint:code && pnpm lint:markdown && pnpm lint:openapi && pnpm lint:dead-code && pnpm lint:duplicates && pnpm lint:complexity",
    "lint:code": "oxlint --deny-warnings --report-unused-disable-directives --threads=1 e2e playwright.config.ts && turbo run lint",
    "lint:complexity": "node scripts/quality-metrics.mjs halstead",
    "lint:dead-code": "knip",
    "lint:duplicates": "jscpd --config .jscpd.json",
    "lint:fix": "oxlint --deny-warnings --fix --threads=1 e2e playwright.config.ts && turbo run lint:fix",
    "lint:markdown": "markdownlint-cli2",
    "lint:openapi": "redocly lint --config apps/api/redocly.yaml",
    "prepare": "lefthook install",
    "test": "pnpm test:metrics && turbo run test --concurrency=1",
    "test:component": "turbo run test:component",
    "test:coverage": "turbo run test:coverage --concurrency=1",
    "test:e2e": "pnpm --filter @workspace/config-interpolation build && playwright test",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "test:e2e:ui": "playwright test --ui",
    "test:integration": "pnpm --filter api test:integration",
    "test:metrics": "node --test scripts/quality-metrics.test.mjs",
    "test:mutation": "turbo run test:mutation --concurrency=1",
    "test:mutation:aggregate": "pnpm --filter api test:mutation:aggregate",
    "test:mutation:check": "pnpm --filter api test:mutation:check",
    "test:mutation:dry": "turbo run test:mutation:dry --concurrency=1",
    "test:mutation:shard": "pnpm --filter api test:mutation:shard",
    "test:mutation:tooling": "pnpm --filter api test:mutation:tooling",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.78.0",
    "@playwright/test": "catalog:",
    "@redocly/cli": "2.46.2",
    "@workspace/config-typescript": "workspace:*",
    "eslint-plugin-sonarjs": "4.2.0",
    "jscpd": "5.0.16",
    "knip": "6.32.2",
    "lefthook": "2.1.9",
    "markdownlint-cli2": "0.23.2",
    "oxlint": "catalog:",
    "prettier": "catalog:",
    "shadcn": "catalog:",
    "ts-complex": "1.0.0",
    "tsx": "catalog:",
    "turbo": "^2.10.4",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.19"
  }
}
