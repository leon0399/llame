e text uses the full\n// row, and the fade only arrives with the buttons it hides text behind.\nconst columnFade = cn(\n  \"[mask-image:linear-gradient(to_right,#000_calc(100%-var(--fade-from,0px)),transparent_calc(100%-var(--fade-to,0px)))]\",\n  // Hover, keyboard focus and an open row menu all show BOTH actions.\n  `group-hover/menu-item:[--fade-from:${px(ACTIONS.FADE)}] group-hover/menu-item:[--fade-to:${px(ACTIONS.CLEAR)}]`,\n  `group-focus-within/menu-item:[--fade-from:${px(ACTIONS.FADE)}] group-focus-within/menu-item:[--fade-to:${px(ACTIONS.CLEAR)}]`,\n  `group-has-[[aria-expanded=true]]/menu-item:[--fade-from:${px(ACTIONS.FADE)}] group-has-[[aria-expanded=true]]/menu-item:[--fade-to:${px(ACTIONS.CLEAR)}]`,\n  // The single action a pinned/active row shows without hover.\n  `data-[rest-action=true]:[--fade-from:${px(ONE_ACTION.FADE)}] data-[rest-action=true]:[--fade-to:${px(ONE_ACTION.CLEAR)}]`,\n);\n\n/**\n * SidebarRowText wraps a sidebar row's text (title, excerpt, badges) and fades\n * it out beneath the row's hover actions, so the actions need no reserved\n * padding and the text can use the whole row while they are hidden.\n *\n * @summary the text column of a sidebar row, faded under the row actions\n */\nexport function SidebarRowText({\n  restAction = false,\n  className,\n  children,\n}: {\n  /** True when one action stays visible without hover (pinned/active rows). */\n  restAction?: boolean;\n  className?: string;\n  children: React.ReactNode;\n}) {\n  return (\n    <span data-rest-action={restAction} className={cn(columnFade, className)}>\n      {children}\n    </span>\n  );\n}\n\n/**\n * SidebarRowTitle renders a row title that fades out (never ellipses) when it\n * is too long, and scrolls to its end — marquee-style, once, no wrap, no loop —\n * while the row is hovered or focused, reversing faster on leave. Use it for\n * titles whose tail is worth reading; use a plain `truncate` for text this view\n * has no intent to reveal.\n *\n * @summary