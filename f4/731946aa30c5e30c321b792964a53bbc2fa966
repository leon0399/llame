Text>\n        </InputGroupAddon>\n        <InputGroupInput\n          placeholder=\"example.com\"\n          className=\"pl-0.5!\"\n          aria-label=\"Domain\"\n        />\n        <InputGroupAddon align=\"inline-end\">\n          <InputGroupText>.com</InputGroupText>\n        </InputGroupAddon>\n      </InputGroup>\n      <InputGroup>\n        <InputGroupInput\n          placeholder=\"Enter your username\"\n          aria-label=\"Username\"\n        />\n        <InputGroupAddon align=\"inline-end\">\n          <InputGroupText>@company.com</InputGroupText>\n        </InputGroupAddon>\n      </InputGroup>\n      <InputGroup>\n        <InputGroupTextarea placeholder=\"Enter your message\" aria-label=\"Message\" />\n        <InputGroupAddon align=\"block-end\">\n          <InputGroupText className=\"text-xs text-muted-foreground\">\n            120 characters left\n          </InputGroupText>\n        </InputGroupAddon>\n      </InputGroup>\n    </div>\n  ),\n};\n\n/**\n * Use `block-start`/`block-end` addons to turn the group into a small editor\n * pane: the toolbar and status row belong to the field rather than floating\n * beside it.\n *\n * Verbatim from [shadcn Input Group / Textarea](https://ui.shadcn.com/docs/components/base/input-group#textarea).\n *\n * @summary for a multi-line control with toolbar and status rows\n */\nexport const WithTextarea: Story = {\n  tags: [\"shadcn-example\", \"ai-generated\"],\n  render: () => (\n    <div className=\"grid gap-4\">\n      <InputGroup>\n        <InputGroupTextarea\n          id=\"textarea-code-32\"\n          placeholder=\"console.log('Hello, world!');\"\n          aria-label=\"Script source\"\n          className=\"min-h-[200px]\"\n        />\n        <InputGroupAddon align=\"block-end\" className=\"border-t\">\n          <InputGroupText>Line 1, Column 1</InputGroupText>\n          <InputGroupButton size=\"sm\" className=\"ml-auto\" variant=\"default\">\n            Run <CornerDownLeftIcon />\n          </InputGroupButton>\n        </InputGroupAddon>\n        <InputGroupAddon align=\"block-start\" className=\"border-b\">\n          <InputGroupText className=\"font-mono font-medium\">\n            <BracesIcon />\n            script.js\n          </InputGroupText>\n          <InputGroupButton\n            className=\"ml-auto\"\n            size=\"icon-xs\"\n            aria-label=\"Reload\"\n          >\n            <RefreshCwIcon />\n          </InputGroupButton>\n          <InputGroupButton variant=\"ghost\" size=\"icon-xs\" aria-label=\"Copy\">\n            <CopyIcon />\n          </InputGroupButton>\n        </InputGroupAddon>\n      </InputGroup>\n    </div>\n  ),\n};\n\n/**\n * The shape llame's own filter fields use (`SearchFilterInput`): a magnifier\n * addon, and a clear button that only exists while there is something to\n * clear. The play function types, clears, and asserts both the callback and\n * that the button is gone again.\n *\n * @summary for a search/filter field with a conditional clear button\n */\nexport const Search: Story = {\n  tags: [\"ai-generated\"],\n  args: { onChange: fn() },\n  argTypes: { onChange: { control: false } },\n  render: function SearchRender(args) {\n    const [value, setValue] = React.useState(\"\");\n\n    return (\n      <InputGroup>\n        <InputGroupAddon>\n          <SearchIcon />\n        </InputGroupAddon>\n        <InputGroupInput\n          value={value}\n          onChange={(event) => {\n            setValue(event.target.value);\n            args.onChange?.(event);\n          }}\n          placeholder=\"Search projects…\"\n          aria-label=\"Search projects\"\n        />\n        {value !== \"\" && (\n          <InputGroupAddon align=\"inline-end\">\n            <InputGroupButton size=\"icon-xs\" onClick={() => setValue(\"\")}>\n              <XIcon />\n              <span className=\"sr-only\">Clear search</span>\n            </InputGroupButton>\n          </InputGroupAddon>\n        )}\n      </InputGroup>\n    );\n  },\n  play: async ({ canvas, args }) => {\n    const field = canvas.getByRole(\"textbox\", { name: \"Search projects\" });\n    await userEvent.type(field, \"res\");\n    await expect(args.onChange).toHaveBeenCalled();\n\n    await userEvent.click(canvas.getByRole(\"button\", { name: \"Clear search\" }));\n    await expect(field).toHaveValue(\"\");\n    await expect(\n      canvas.queryByRole(\"button\", { name: \"Clear search\" }),\n    ).toBeNull();\n  },\n};\n",
