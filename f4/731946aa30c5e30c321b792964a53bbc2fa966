\n  const measure = useCallback(() => {\n    const clip = clipRef.current;\n    const node = textRef.current;\n    if (!clip || !node) return;\n\n    const overflowing = node.scrollWidth > clip.clientWidth;\n    clip.dataset.overflowing = String(overflowing);\n    // Native tooltip only where there is something the fade hides; it is the\n    // tail's only route for pointerless and reduced-motion users.\n    clip.title = overflowing ? text : \"\";\n\n    // Scroll far enough that the title's end clears the action zone, measured\n    // against the ROW (the title's own box stops short of it when a badge\n    // follows). `scrollWidth` is layout width, so this stays correct even if a\n    // re-measure lands while the text is translated.\n    const row = clip.closest(\"[data-sidebar=menu-item]\") ?? clip;\n    const textEnd = clip.getBoundingClientRect().left + node.scrollWidth;\n    const shift = Math.max(\n      0,\n      textEnd - (row.getBoundingClientRect().right - SCROLL_CLEARANCE),\n    );\n    const duration = Math.min(\n      SCROLL_MS.MAX,\n      Math.max(SCROLL_MS.MIN, (shift / SCROLL_SPEED) * 1000),\n    );\n    // Negative, so the utility below needs no negated arbitrary value.\n    node.style.setProperty(\"--marquee-x\", `${-Math.round(shift)}px`);\n    node.style.setProperty(\"--marquee-ms\", `${Math.round(duration)}ms`);\n  }, [text]);\n\n  // Re-measured on pointer enter as well: the appearance system can swap the\n  // font after mount, and that read lands before the scroll transition runs.\n  useEffect(measure, [measure]);\n\n  return (\n    <span\n      ref={clipRef}\n      onPointerEnter={measure}\n      className={cn(\n        \"block min-w-0 overflow-hidden text-clip whitespace-nowrap\",\n        \"data-[overflowing=true]:[mask-image:linear-gradient(to_right,#000_calc(100%_-_24px),transparent)]\",\n        className,\n      )}\n    >\n      <span\n        ref={textRef}\n        className={cn(\n          // Leaving reverses at a flat 200ms — fast