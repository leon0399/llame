            "content": "\"use client\";\n\nimport { useState, type ReactNode } from \"react\";\nimport { ChevronDownIcon, FolderIcon, FolderOpenIcon } from \"lucide-react\";\n\nimport { Button } from \"@workspace/ui/components/button\";\nimport { CommandGroup, CommandItem } from \"@workspace/ui/components/command\";\nimport {\n  Popover,\n  PopoverContent,\n  PopoverTrigger,\n} from \"@workspace/ui/components/popover\";\n\nimport {\n  ProjectSearchItems,\n  SearchList,\n  SearchListAction,\n  SearchListCheck,\n} from \"@/components/search-list\";\nimport { machinePathFromRoot } from \"@/lib/services/machines/locator\";\n\nimport { ComposerTooltip } from \"./composer-tooltip\";\nimport type { ComposerProject } from \"./composer-project\";\nimport { folderName } from \"./composer-working-directory\";\nimport type {\n  ComposerLocation,\n  WorkingDirectoryOption,\n} from \"./use-composer-location\";\n\n/*\n * The two choices of where a new chat starts, each a search list whose\n * search filters only its own items: the project, and the folder. Each list\n * starts with the way to clear its choice, so the row has no separate ×.\n */\n\n/** A quiet control in the row under the input that opens a search list. */\nfunction StartPicker({\n  tooltip,\n  ariaLabel,\n  icon,\n  label,\n  placeholder,\n  children,\n}: {\n  tooltip: string;\n  ariaLabel: string;\n  icon: ReactNode;\n  label: string;\n  placeholder: string;\n  children: (close: () => void) => ReactNode;\n}) {\n  const [open, setOpen] = useState(false);\n\n  return (\n    <Popover open={open} onOpenChange={setOpen}>\n      <ComposerTooltip\n        label={tooltip}\n        render={\n          <PopoverTrigger\n            render={\n              <Button\n                type=\"button\"\n                variant=\"ghost\"\n                size=\"xs\"\n                aria-label={ariaLabel}\n                className=\"min-w-24 shrink\"\n              />\n            }\n          />\n        }\n      >\n        {icon}\n        <span className=\"min-w-0 overflow-x-clip font-normal text-ellipsis whitespace-nowrap [text-box:trim-both_cap_alphabetic]\">\n          {label}\n        </span>\n        <ChevronDownIcon aria-hidden className=\"opacity-60\" />\n      </ComposerTooltip>\n      <PopoverContent\n        aria-label={tooltip}\n        align=\"start\"\n        className=\"w-80 overflow-hidden p-0\"\n      >\n        <SearchList placeholder={placeholder}>\n          {children(() => setOpen(false))}\n        </SearchList>\n      </PopoverContent>\n    </Popover>\n  );\n}\n\n/** The project the chat is filed into; hidden where the page fixes it. */\nexport function ProjectPicker({ project }: { project: ComposerProject }) {\n  if (project.locked === true) return null;\n\n  const selected = project.selected;\n\n  return (\n    <StartPicker\n      tooltip=\"Project\"\n      ariaLabel={selected === null ? \"Project\" : `Project, ${selected.name}`}\n      icon={<FolderIcon aria-hidden />}\n      label={selected?.name ?? \"Project\"}\n      placeholder=\"Search projects…\"\n    >\n      {(close) => (\n        <>\n          {selected === null ? null : (\n            <SearchListAction\n              position=\"first\"\n              label=\"No project\"\n              onSelect={() => {\n                project.onSelect(null);\n                close();\n              }}\n            />\n          )}\n          <ProjectSearchItems\n            projects={project.projects}\n            selectedId={selected?.id ?? null}\n            onSelect={(projectId) => {\n              project.onSelect(projectId);\n              close();\n            }}\n          />\n        </>\n      )}\n    </StartPicker>\n  );\n}\n\nfunction FolderItem({\n  option,\n  selected,\n  onSelect,\n}: {\n  option: WorkingDirectoryOption;\n  selected: boolean;\n  onSelect: () => void;\n}) {\n  const path = machinePathFromRoot(option.path) ?? option.path;\n\n  return (\n    <CommandItem\n      value={`${folderName(option.path)} ${option.machine} ${path}`}\n      aria-label={`${option.machine}: ${option.path}`}\n      onSelect={onSelect}\n    >\n      <span className=\"flex min-w-0 flex-col\">\n        <span className=\"truncate\">{folderName(option.path)}</span>\n        <span className=\"truncate text-xs text-muted-foreground\">\n          {option.machine} · {path}\n        </span>\n      </span>\n      <SearchListCheck on={selected} />\n    </CommandItem>\n  );\n}\n\nfunction FolderGroup({\n  heading,\n  options,\n  location,\n  close,\n}: {\n  heading: string;\n  options: Array<WorkingDirectoryOption>;\n  location: ComposerLocation;\n  close: () => void;\n}) {\n  if (options.length === 0) return null;\n\n  const current = location.location.checkout?.id;\n\n  return (\n    <CommandGroup heading={heading}>\n      {options.map((option) => (\n        <FolderItem\n          key={option.checkoutId}\n          option={option}\n          selected={option.checkoutId === current}\n          onSelect={() => {\n            const row = location.checkouts.find(\n              (item) => item.id === option.checkoutId,\n            );\n\n            if (row !== undefined) location.selectWorkingDirectory(row);\n            close();\n          }}\n        />\n      ))}\n    </CommandGroup>\n  );\n}\n\n/** The folder list: no folder first, the project's repositories, every other\n *  checkout, then a typed folder. */\nfunction FolderSearchItems({\n  location,\n  onOtherFolder,\n  close,\n}: {\n  location: ComposerLocation;\n  onOtherFolder: () => void;\n  close: () => void;\n}) {\n  const options = location.workingDirectories;\n\n  return (\n    <>\n      {location.location.checkout === null ? null : (\n        <SearchListAction\n          position=\"first\"\n          label=\"No folder\"\n          onSelect={() => {\n            location.clearWorkingDirectory();\n            close();\n          }}\n        />\n      )}\n      <FolderGroup\n        heading=\"This project\"\n        options={options.filter((row) => row.linked)}\n        location={location}\n        close={close}\n      />\n      <FolderGroup\n        heading=\"Checkouts\"\n        options={options.filter((row) => !row.linked)}\n        location={location}\n        close={close}\n      />\n      <SearchListAction\n        position=\"last\"\n        label=\"Other folder…\"\n        onSelect={() => {\n          close();\n          // Deferred so the popover closes before the dialog takes focus.\n          setTimeout(onOtherFolder, 0);\n        }}\n      />\n    </>\n  );\n}\n\n/** The folder the chat works in. */\nexport function FolderPicker({\n  location,\n  onOtherFolder,\n}: {\n  location: ComposerLocation;\n  onOtherFolder: () => void;\n}) {\n  const checkout = location.location.checkout;\n  const name = checkout === null ? null : folderName(checkout.path);\n\n  return (\n    <StartPicker\n      tooltip=\"Folder\"\n      ariaLabel={name === null ? \"Folder\" : `Folder, ${name}`}\n      icon={<FolderOpenIcon aria-hidden />}\n      label={name ?? \"Folder\"}\n      placeholder=\"Search folders…\"\n    >\n      {(close) => (\n        <FolderSearchItems\n          location={location}\n          onOtherFolder={onOtherFolder}\n          close={close}\n        />\n      )}\n    </StartPicker>\n  );\n}\n",
