der, and no folder. */\nexport function FolderPicker({\n  location,\n  onOtherFolder,\n}: {\n  location: ComposerLocation;\n  onOtherFolder: () => void;\n}) {\n  const checkout = location.location.checkout;\n  const options = location.workingDirectories;\n\n  return (\n    <StartPicker\n      tooltip=\"Folder\"\n      ariaLabel={\n        checkout === null ? \"Folder\" : `Folder, ${folderName(checkout.path)}`\n      }\n      icon={<FolderOpenIcon aria-hidden />}\n      label={checkout === null ? \"Folder\" : folderName(checkout.path)}\n      placeholder=\"Search folders…\"\n    >\n      {(close) => (\n        <>\n          <FolderGroup\n            heading=\"This project\"\n            options={options.filter((row) => row.linked)}\n            location={location}\n            close={close}\n          />\n          <FolderGroup\n            heading=\"Checkouts\"\n            options={options.filter((row) => !row.linked)}\n            location={location}\n            close={close}\n          />\n          <CommandSeparator />\n          <CommandGroup>\n            <CommandItem\n              value=\"Other folder…\"\n              onSelect={() => {\n                close();\n                // Deferred so the popover closes before the dialog takes focus.\n                setTimeout(onOtherFolder, 0);\n              }}\n            >\n              Other folder…\n            </CommandItem>\n            {checkout === null ? null : (\n              <CommandItem\n                value=\"No folder\"\n                onSelect={() => {\n                  location.clearWorkingDirectory();\n                  close();\n                }}\n              >\n                No folder\n              </CommandItem>\n            )}\n          </CommandGroup>\n        </>\n      )}\n    </StartPicker>\n  );\n}\n",
