inish\n    if not out.strip().startswith('data:') and out.strip():\n        error = out.strip()[:300]\n    details = (usage or {}).get('completion_tokens_details') or {}\n    return {'prompt_tokens': (usage or {}).get('prompt_tokens'), 'completion_tokens': (usage or {}).get('completion_tokens'),\n            'reasoning_tokens': details.get('reasoning_tokens'), 'reasoning_chars': reasoning_chars,\n            'text_chars': len(text), 'answer': answer_of(text), 'finish': finish,\n            'timeout': rc == 28, 'curl_rc': rc, 'error': error or (err[:200] if rc not in (0, 28) else None)}\n\n\ndef run_messages(model, extra):\n    body = {'model': model, 'max_tokens': 8192, 'stream': True, 'messages': [{'role': 'user', 'content': PROMPT}]}\n    body.update(extra)\n    out, err, rc = curl(f'{BASE}/messages', body, ['x-api-key: ' + key, 'anthropic-version: 2023-06-01'])\n    usage, text, thinking_chars, stop, error = {}, '', 0, None, None\n    for line in out.splitlines():\n        if not line.startswith('data: '):\n            continue\n        try:\n            e = json.loads(line[6:])\n        except Exception:\n            continue\n        t = e.get('type')\n        if t == 'message_start':\n            usage.update(e['message'].get('usage') or {})\n        elif t == 'content_block_delta':\n            d = e.get('delta') or {}\n            if d.get('type') == 'thinking_delta':\n                thinking_chars += len(d.get('thinking') or '')\n            elif d.get('type') == 'text_delta':\n                text += d.get('text') or ''\n        elif t == 'message_delta':\n            usage.update(e.get('usage') or {})\n            stop = (e.get('delta') or {}).get('stop_reason') or stop\n        elif t == 'error':\n            error = json.dumps(e)[:300]\n    stripped = out.strip()\n    if stripped.startswith('{'):\n        error = stripped[:300]\n    return {'input_tokens': usage.get('input_tokens'), 'output_tokens': usage.get('output_tokens'),\n            'thinking_chars': thinking_chars, 'text_chars': len(text), 'answer': answer_of(text), 'stop': stop,\n            'timeout': rc == 28, 'curl_rc': rc, 'error': error or (err[:200] if rc not in (0, 28) else None)}\n\n\njobs = []\nfor model in THINK_KW:\n    for cell, extra in completions_cells(model).items():\n        jobs += [(model, 'completions', cell, extra)] * N\n    for cell, extra in MESSAGES_CELLS.items():\n        jobs += [(model, 'messages', cell, extra)] * N\nrandom.seed(20261006)\nrandom.shuffle(jobs)\n\n\ndef work(job):\n    model, wire, cell, extra = job\n    start = time.time()\n    result = (run_completions if wire == 'completions' else run_messages)(model, extra)\n    record = {'model': model, 'wire': wire, 'cell': cell, 'start': round(start, 1), 'seconds': round(time.time() - start, 1), **result}\n    with open(OUT, 'a') as f:\n        f.write(json.dumps(record) + '\\n')\n    return record\n\n\nprint(f'{len(jobs)} jobs, concurrency 2, timeout {TIMEOUT}s', flush=True)\nwith ThreadPoolExecutor(2) as pool:\n    for i, rec in enumerate(pool.map(work, jobs), 1):\n        if i % 10 == 0:\n            print(f'{i}/{len(jobs)} done', flush=True)\nprint('complete', flush=True)\n",
