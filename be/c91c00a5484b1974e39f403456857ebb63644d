absent-safe predicates, and committed-turn availability comparison.\n- v2 (2026-09-12): Source review identified nested prompt asset packaging and\n  boot-loading dependencies; the earlier binding design was superseded by v3.\n- v1 (2026-09-12): Initial draft before the runtime/storage decisions were settled.\n`;\nconst p=load(\"draftRoot\")+\"/design.md\";\nconst old=await tools.exec_command({cmd:\"sed -n '1,1200p' openspec/changes/tool-prompt-templates/design.md\",max_output_tokens:16000});\ntext(await tools.apply_patch(\"*** Begin Patch\\n*** Update File: \"+p+\"\\n@@\\n\"+old.output.trimEnd().split(\"\\n\").map(x=>\"-\"+x).join(\"\\n\")+\"\\n\"+design.trimEnd().split(\"\\n\").map(x=>\"+\"+x).join(\"\\n\")+\"\\n*** End Patch\"));\nstore(\"designV3\",design);\n",
