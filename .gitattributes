# Normalize line endings to LF in the repo and on checkout, so Windows/WSL
# core.autocrlf can't phantom-dirty the working tree (perpetual "modified" status,
# unremovable worktrees, noisy diffs). LF everywhere.
* text=auto eol=lf

# Scripts must stay LF regardless of platform.
*.sh text eol=lf

# Lockfiles: generated — collapse in diffs and don't count toward language stats.
pnpm-lock.yaml linguist-generated=true -diff

# drizzle-kit journal + schema snapshots: generated, never hand-edited, and large
# enough to bury a review. Collapse in diffs; keep them textually diffable so
# schema drift can still be inspected locally. The migration .sql files stay
# fully visible — those are the reviewable artifact.
apps/api/src/db/migrations/meta/** linguist-generated=true

# Binary assets (never normalize / diff).
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.woff  binary
*.woff2 binary

# Parallel PRs add entries at the same place at the top. The root `prepare`
# script registers scripts/merge-changelog.mjs, which merges pure additions
# per date section and leaves every other change to git's text merge. Local
# merges and rebases only: GitHub's server-side merge ignores merge drivers.
CHANGELOG.md merge=changelog

# Sourced by the generated git hook shim; a CR would abort every hook.
.lefthookrc text eol=lf
