# Normalize line endings to LF in the repo and on checkout, so Windows/WSL
# core.autocrlf can't phantom-dirty the working tree (perpetual "modified" status,
# unremovable worktrees, noisy diffs). LF everywhere.
* text=auto eol=lf

# Scripts must stay LF regardless of platform.
*.sh text eol=lf

# Lockfiles: generated — collapse in diffs and don't count toward language stats.
pnpm-lock.yaml linguist-generated=true -diff
Cargo.lock linguist-generated=true -diff

# Drizzle snapshots are generated and remain textually diffable. Migration SQL
# stays visible because it is the reviewable artifact.
apps/api/src/db/migrations/**/snapshot.json linguist-generated=true

# Code generated from openapi.json (orval), asyncapi.websocket.yaml (live protocol) and
# asyncapi.queues.yaml (queue payloads).
# CI regenerates and fails on drift, so review the source documents instead.
# openapi.json stays visible: it is the reviewable API contract.
apps/web/lib/api/generated/** linguist-generated=true
apps/web/lib/api/live-generated/** linguist-generated=true
apps/api/src/live/generated/** linguist-generated=true
apps/api/src/queue/generated/** linguist-generated=true

# TypeScript bindings generated from packages/machine-protocol/proto by buf.
# `proto:check` regenerates and fails on drift, so review the .proto files instead.
packages/machine-protocol/src/generated/** linguist-generated=true

# Binary assets (never normalize / diff).
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.woff  binary
*.woff2 binary

# Sourced by the generated git hook shim; a CR would abort every hook.
.lefthookrc text eol=lf
