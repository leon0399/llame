$out_dir/zap:/zap/wrk/out\" \\\n    -u \"$(id -u):$(id -g)\" \\\n    \"$zap_image\" zap.sh -cmd -autorun /zap/wrk/zap-plan.yaml \\\n    2>&1 | tee \"$out_dir/zap/console.txt\" || status=1\nfi\n\nexit \"$status\"\n",
